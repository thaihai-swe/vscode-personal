{
    "files.trimFinalNewlines": false,
    "files.trimTrailingWhitespace": false,
    // Paste screenshots and images
    // Other useful notebook settings
    "markdown.updateLinksOnFileMove.enabled": "always",
    "editor.pasteAs.enabled": true,
    "markdown.editor.filePaste.enabled": "always",
    "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",
    "markdown.copyFiles.destination": {
        "**/*.md": "assets/${documentBaseName}/"
    },
    "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
    "markdown.preview.breaks": false,
    "markdown.preview.linkify": true,
    "markdown.preview.doubleClickToSwitchToEditor": true,
    // ======================================================================
    // 1. Window, themes, startup, and focus behavior
    // ----------------------------------------------------------------------
    // Shell architecture: floating islands, tactile specular glass, and compact density.
    // Theme colors and typography adapt to the selected VS Code theme.
    // ======================================================================
    // Set zoomLevel to 0 for crisp 1:1 physical pixel rendering on Retina/4K displays.
    "window.zoomLevel": 1.1,
    "workbench.colorTheme": "Islands Dark",
    "workbench.preferredDarkColorTheme": "Islands Dark",
    "workbench.preferredLightColorTheme": "Warm Editorial",
    "window.autoDetectColorScheme": true,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.startupEditor": "welcomePage",
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "workbench.layoutControl.enabled": false,
    "window.restoreWindows": "all",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${appName}",
    "zenMode.centerLayout": false,
    "zenMode.fullScreen": false,
    "zenMode.hideActivityBar": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    "zenMode.restore": true,
    // ======================================================================
    // 2. Editor scrollbar and minimap
    // ----------------------------------------------------------------------
    // Thin floating rails; minimap slider always visible, canvas fades until hover.
    // ======================================================================
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.verticalScrollbarSize": 12,
    "editor.scrollbar.horizontalScrollbarSize": 10,
    "editor.minimap.enabled": true,
    "editor.minimap.side": "right",
    "editor.minimap.scale": 1,
    "editor.minimap.size": "proportional",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.maxColumn": 120,
    "editor.minimap.showSlider": "always",
    // ======================================================================
    // 3. Editor behavior and typography
    // ----------------------------------------------------------------------
    // Long-session comfort. Clear text, generous leading, and low motion.
    // ======================================================================
    "editor.fontFamily": "'Lilex', 'JetBrains Mono', 'JetBrainsMono Nerd Font', 'IBM Plex Mono', 'Monaspace Neon', 'Fira Code', 'Menlo', 'Monaco', monospace",
    "editor.fontSize": 15,
    "editor.fontWeight": "400",
    // 25px line height provides an exact 1.66x buffer ratio for crisp, comfortable vertical density.
    "editor.lineHeight": 25,
    "editor.letterSpacing": 0,
    "editor.fontLigatures": "'calt', 'liga', 'zero', 'ss01', 'ss02', 'cv01'",
    "editor.semanticHighlighting.enabled": true,
    "editor.find.addExtraSpaceOnTop": true,
    "editor.find.autoFindInSelection": "multiline",
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.mouseWheelZoom": false,
    "editor.padding.top": 16,
    "editor.padding.bottom": 20,
    "editor.smoothScrolling": true,
    "editor.scrollBeyondLastColumn": 3,
    "editor.scrollPredominantAxis": true,
    "editor.fastScrollSensitivity": 5,
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.cursorSurroundingLines": 8,
    "editor.cursorSurroundingLinesStyle": "default",
    "editor.scrollBeyondLastLine": false,
    "editor.wordWrap": "off",
    "editor.wrappingIndent": "same",
    "editor.renderLineHighlight": "line",
    "editor.renderFinalNewline": "dimmed",
    "editor.renderWhitespace": "boundary",
    "editor.renderControlCharacters": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.dragAndDrop": true,
    "editor.stickyTabStops": true,
    "editor.largeFileOptimizations": true,
    "editor.accessibilitySupport": "auto",
    "accessibility.signalOptions.volume": "off",
    // Eye-care: less constant glow, clear column anchors, calmer highlights.
    "editor.matchBrackets": "near",
    "editor.occurrencesHighlight": "singleFile",
    "editor.selectionHighlight": true,
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    // Formatting and save actions.
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    // Unicode safety.
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    // ======================================================================
    // 4. Suggestions, hints, hover, and code navigation
    // ----------------------------------------------------------------------
    // Instant IntelliSense, unobtrusive hover delays, parameter hints.
    // ======================================================================
    "workbench.quickOpen.closeOnFocusLost": true,
    "workbench.quickOpen.preserveInput": true,
    "editor.suggest.preview": true,
    "editor.suggest.previewMode": "prefix",
    "editor.suggest.insertMode": "replace",
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggestSelection": "recentlyUsedByPrefix",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.suggest.localityBonus": true,
    "editor.suggest.showStatusBar": true,
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.showToolbar": "onHover",
    "editor.inlineSuggest.suppressSuggestions": false,
    "editor.parameterHints.enabled": true,
    "editor.parameterHints.cycle": true,
    "editor.linkedEditing": true,
    "editor.hover.enabled": "on",
    "editor.hover.delay": 300,
    "editor.hover.sticky": true,
    "editor.codeLens": false,
    "editor.codeLensFontSize": 14,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontSize": 14,
    "editor.inlayHints.padding": true,
    "editor.inlayHints.maximumLength": 40,
    // ======================================================================
    // 5. Indent guides, bracket guides, and sticky scroll
    // ----------------------------------------------------------------------
    // Native Indent Rainbow: six cycling hues provided directly by each theme
    // so nested blocks are readable at a glance. Guides stay on across all
    // indent columns; the active column and matching bracket pair render stronger.
    // ======================================================================
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": "always",
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": "active",
    "editor.guides.highlightActiveBracketPair": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 3,
    "editor.stickyScroll.scrollWithEditor": true,
    // ======================================================================
    // 6. Breadcrumbs
    // ======================================================================
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    "breadcrumbs.icons": true,
    "breadcrumbs.showArrays": true,
    "breadcrumbs.showBooleans": true,
    "breadcrumbs.showClasses": true,
    "breadcrumbs.showConstants": true,
    "breadcrumbs.showConstructors": true,
    "breadcrumbs.showEnumMembers": true,
    "breadcrumbs.showEnums": true,
    "breadcrumbs.showFields": true,
    "breadcrumbs.showFiles": true,
    "breadcrumbs.showFunctions": true,
    "breadcrumbs.showInterfaces": true,
    "breadcrumbs.showMethods": true,
    "breadcrumbs.showModules": true,
    "breadcrumbs.showObjects": true,
    "breadcrumbs.showPackages": true,
    "breadcrumbs.showProperties": true,
    "breadcrumbs.showStructs": true,
    "breadcrumbs.showVariables": true,
    // ======================================================================
    // 7. Workbench tabs and editor management
    // ----------------------------------------------------------------------
    // Firefox Nova tabs: separated, rounded browser tabs with a quiet strip,
    // a raised active surface, and controls that appear on intent.
    // ======================================================================
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.reduceMotion": "user",
    "workbench.editor.emptyWindowText": "off",
    "workbench.settings.useSplitJSON": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.pinnedTabsOnSeparateRow": false,
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.tabCloseButton": "right",
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.editor.tabActionUnpinVisibility": true,
    "workbench.editor.tabActionLocation": "right",
    "workbench.editor.alwaysShowEditorActions": false,
    "workbench.editor.showIcons": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "default",
    "workbench.editor.restoreViewState": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.decorations.colors": true,
    "workbench.editor.decorations.badges": true,
    "workbench.editor.focusRecentEditorAfterClose": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.closeEmptyGroups": true,
    "workbench.editor.splitSizing": "split",
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    "editor.dimUnfocusedEditors": false,
    // ======================================================================
    // 8. Explorer / solution-view behavior
    // ======================================================================
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.expandMode": "singleClick",
    "workbench.list.smoothScrolling": true,
    "workbench.list.keyboardNavigation": "highlight",
    "explorer.openEditors.visible": 0,
    "explorer.autoReveal": "focusNoScroll",
    "explorer.incrementalNaming": "smart",
    "explorer.confirmDragAndDrop": true,
    "explorer.confirmDelete": true,
    "explorer.confirmPasteNative": false,
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lock, bun.lockb, .npmrc, .yarnrc.yml, pnpm-workspace.yaml, biome.json, biome.jsonc",
        "tsconfig.json": "tsconfig.*.json",
        "vite.config.*": "vitest.config.*, playwright.config.*, cypress.config.*",
        "next.config.*": "next-env.d.ts, middleware.*, instrumentation.*",
        "tailwind.config.*": "postcss.config.*, components.json",
        "eslint.config.*": ".eslintignore",
        "prettier.config.*": ".prettierignore",
        "README.md": "CHANGELOG.md, LICENSE, SECURITY.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md",
        "Dockerfile": ".dockerignore, docker-compose*.yml, compose*.yml",
        ".env": ".env.*, !.env.example, .envrc",
        "Cargo.toml": "Cargo.lock, Cross.toml",
        "pyproject.toml": "poetry.lock, uv.lock, pdm.lock, requirements*.txt",
        "go.mod": "go.sum, go.work, go.work.sum"
    },
    // ======================================================================
    // 9. Search, files, excludes, and performance
    // ======================================================================
    "search.searchOnType": true,
    "search.showLineNumbers": true,
    "search.decorations.colors": true,
    "search.collapseResults": "auto",
    "search.smartCase": true,
    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true,
    "search.quickOpen.includeSymbols": true,
    "search.searchEditor.doubleClickBehaviour": "goToLocation",
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 1000,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    "files.simpleDialog.enable": false,
    "files.hotExit": "onExitAndWindowClose",
    "files.restoreUndoStack": true,
    "search.exclude": {
        "**/.angular": true,
        "**/.svelte-kit": true,
        "**/.astro": true,
        "**/.output": true,
        "**/.serverless": true,
        "**/.pnpm-store": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/.vscode": false,
        "**/.idea": true,
        "**/*.log": true,
        "**/coverage": true,
        ".pytest_cache": true,
        "__pycache__": true,
        "**/__pycache__": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.watcherExclude": {
        "**/.angular/**": true,
        "**/.svelte-kit/**": true,
        "**/.astro/**": true,
        "**/.output/**": true,
        "**/.serverless/**": true,
        "**/.pnpm-store/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/**": true,
        "**/*.log": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.turbo/**": true,
        "**/.cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.tox/**": true,
        "**/.parcel-cache/**": true,
        "**/coverage/**": true
    },
    // ======================================================================
    // 10. Terminal
    // ----------------------------------------------------------------------
    // Integrated GPU rendering, persistent sessions, and ergonomic tabs.
    // ======================================================================
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.tabs.hideCondition": "never",
    "terminal.integrated.minimumContrastRatio": 7,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.stickyScroll.maxLineCount": 5,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.scrollback": 20000,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.fontFamily": "'JetBrainsMono NFM', 'JetBrainsMono NF', 'Lilex', 'JetBrains Mono', 'JetBrainsMono Nerd Font', 'FiraCode Nerd Font Mono', 'Fira Code', 'IBM Plex Mono', 'Monaspace Neon', 'Menlo', 'Monaco', monospace",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": "450",
    "terminal.integrated.lineHeight": 1.5,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.customGlyphs": true,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.copyOnSelection": true,
    // ======================================================================
    // 11. Git, diff, merge, AI tools
    // ======================================================================
    "git.decorations.enabled": true,
    "git.autorefresh": true,
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    "git.showPushSuccessNotification": true,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "always",
    "git.pruneOnFetch": true,
    "git.branchProtectionPrompt": "alwaysPrompt",
    "scm.defaultViewMode": "tree",
    "scm.showHistoryGraph": true,
    "scm.alwaysShowRepositories": true,
    "scm.diffDecorations": "all",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "on",
    "diffEditor.hideUnchangedRegions.enabled": false,
    "diffEditor.showMoves": true,
    "diffEditor.diffAlgorithm": "advanced",
    "diffEditor.renderIndicators": true,
    "diffEditor.codeLens": true,
    "mergeEditor.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true,
        "python": true,
        "csharp": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "claudeCode.preferredLocation": "panel",
    "chat.editor.fontSize": 14,
    "chat.editor.lineHeight": 23,
    "inlineChat.holdForSpeech": true,
    "editor.dropIntoEditor.enabled": true,
    "editor.pasteAs.showPasteSelector": "afterPaste",
    "scm.startUpdateNotifications": false,
    // ======================================================================
    // 12. Problems panel
    // ======================================================================
    "problems.showWarnings": true,
    "problems.showInfos": true,
    "problems.showCurrentInStatus": true,
    "problems.decorations.enabled": true,
    "problems.autoReveal": false,
    "problems.sortOrder": "severity",
    // ======================================================================
    // 13. Custom UI stylesheet
    // ----------------------------------------------------------------------
    // Floating island architecture, tactile specular glass reflections,
    // Raycast/Spotlight modals, Dynamic Island segmented status bar chips,
    // floating pill tabs, and theme-adaptive OKLCH depth physics. Built for long-session ergonomics.
    // Requires Custom UI Style extension.
    // ======================================================================
    "custom-ui-style.stylesheet": {
        // ------------------------------------------------------------------
        // A. Design tokens & CSS custom properties (Base / Light / Fallback)
        // ------------------------------------------------------------------
        ".monaco-workbench": {
            // Typography hierarchy
            "--nb-font-ui": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', 'Inter', system-ui, sans-serif",
            "--nb-font-heading": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Inter', system-ui, sans-serif",
            "--nb-font-mono": "'Lilex', 'Geist Mono', 'JetBrains Mono', 'IBM Plex Mono', 'Fira Code', 'Menlo', monospace",
            "--nb-font-size-ui": "13px",
            "--nb-font-size-small": "12px",
            "--nb-font-size-heading": "11px",
            "--nb-letter-spacing-heading": "0.05em",
            "--nb-radius-panel": "12px",
            "--nb-radius-card": "10px",
            "--nb-radius-widget": "14px",
            "--nb-radius-input": "6px",
            "--nb-radius-tab": "9px",
            "--nb-radius-item": "5px",
            "--nb-radius-sm": "4px",
            "--nb-radius-pill": "9999px",
            "--nb-panel-gap": "6px",
            "--nb-panel-top": "6px",
            "--nb-panel-bottom": "6px",
            // Base surfaces (Theme-adaptive via OKLCH, solid and high-contrast)
            "--nb-canvas": "color-mix(in oklch, var(--vscode-activityBar-background, var(--vscode-sideBar-background)) 92%, var(--vscode-foreground) 8%)",
            "--nb-surface": "var(--vscode-sideBar-background)",
            "--nb-surface-raised": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
            "--nb-surface-elevated": "color-mix(in oklch, var(--vscode-editorWidget-background, var(--vscode-sideBar-background)) 90%, var(--vscode-foreground) 10%)",
            "--nb-surface-highlight": "color-mix(in oklch, var(--vscode-foreground) 8%, transparent)",
            "--nb-surface-active": "color-mix(in oklch, var(--nb-focus) 14%, var(--nb-surface))",
            "--nb-pill": "color-mix(in oklch, var(--nb-canvas) 75%, var(--nb-surface) 25%)",
            "--nb-pill-hover": "color-mix(in oklch, var(--nb-canvas) 60%, var(--nb-surface) 40%)",
            // Directional specular glass reflections & borders
            "--nb-glass-n": "color-mix(in oklch, var(--vscode-foreground) 12%, transparent)",
            "--nb-glass-s": "color-mix(in oklch, var(--vscode-foreground) 6%, transparent)",
            "--nb-glass-inset": "inset 0 1px 0 var(--nb-glass-n), inset 0 -1px 0 var(--nb-glass-s)",
            "--nb-border": "color-mix(in oklch, var(--vscode-widget-border, var(--vscode-foreground)) 30%, transparent)",
            "--nb-border-soft": "color-mix(in oklch, var(--vscode-foreground) 14%, transparent)",
            "--nb-border-subtle": "color-mix(in oklch, var(--vscode-foreground) 8%, transparent)",
            "--nb-border-hover": "color-mix(in oklch, var(--nb-focus) 65%, transparent)",
            // Floating rounded capsule tab tokens
            "--nb-tab-surface-inactive": "color-mix(in srgb, var(--vscode-foreground) 4%, transparent)",
            "--nb-tab-border-inactive": "color-mix(in srgb, var(--vscode-foreground) 20%, transparent)",
            "--nb-tab-border-hover": "color-mix(in srgb, var(--nb-focus) 65%, transparent)",
            "--nb-tab-outline": "color-mix(in srgb, var(--vscode-foreground) 40%, transparent)",
            "--nb-tab-border": "var(--vscode-tab-border, var(--nb-border-subtle))",
            "--nb-tab-accent": "var(--vscode-tab-activeBorderTop, var(--vscode-tab-activeBorder, var(--nb-focus)))",
            // Shadow hierarchy (Multi-layer ambient + contact physics)
            "--nb-shadow-xs": "0 1px 2px color-mix(in srgb, var(--vscode-widget-shadow, #000) 12%, transparent)",
            "--nb-shadow-sm": "0 2px 6px color-mix(in srgb, var(--vscode-widget-shadow, #000) 18%, transparent)",
            "--nb-shadow-md": "0 6px 18px -3px color-mix(in srgb, var(--vscode-widget-shadow, #000) 24%, transparent)",
            "--nb-shadow-xl": "0 24px 60px -8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 42%, transparent), 0 4px 16px color-mix(in srgb, var(--vscode-widget-shadow, #000) 16%, transparent)",
            "--nb-shadow-spotlight": "0 32px 72px -12px color-mix(in srgb, var(--vscode-widget-shadow, #000) 56%, transparent), 0 8px 24px -4px color-mix(in srgb, var(--vscode-widget-shadow, #000) 22%, transparent)",
            "--nb-surface-shadow": "var(--nb-shadow-md)",
            "--nb-widget-shadow": "var(--nb-shadow-xl)",
            "--nb-shadow-soft": "var(--nb-shadow-sm)",
            "--nb-pill-shadow": "inset 0 1px 2px color-mix(in srgb, #fff 10%, transparent), 0 1px 4px color-mix(in srgb, #000 16%, transparent)",
            // Blur & backdrop
            // Keep backdrop effects subtle; opaque surfaces preserve text clarity.
            "--nb-glass-blur": "blur(8px) saturate(125%)",
            "--nb-blur-strong": "blur(12px) saturate(135%)",
            // Motion & physics
            "--nb-motion-fast": "120ms",
            "--nb-motion-base": "180ms",
            "--nb-motion-slow": "280ms",
            "--nb-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
            "--nb-ease-soft": "cubic-bezier(0.25, 0.1, 0.25, 1)",
            "--nb-transition-ui": "background-color var(--nb-motion-fast) var(--nb-ease-out), border-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)",
            // Focus states — deliberately dual-layer so the ring survives every theme.
            // Some themes ship a fully transparent focusBorder (and a transparent
            // button background); an accent-only ring would then be invisible.
            // Layer 1 is the always-opaque theme foreground, layer 2 adds the
            // accent tint on top, so the ring is visible on any palette.
            // Note the fallback order: some themes (e.g. Islands Dark) ship a fully
            // transparent focusBorder, so the opaque button accent is preferred and
            // the theme foreground is the last-resort final fallback.
            "--nb-focus": "var(--vscode-button-background, var(--vscode-focusBorder, var(--vscode-foreground)))",
            "--nb-focus-contrast": "var(--vscode-foreground)",
            "--nb-focus-ring": "0 0 0 1px var(--nb-focus-contrast), 0 0 0 3px color-mix(in oklch, var(--nb-focus) 45%, transparent)",
            "--nb-focus-ring-offset": "2px",
            "--nb-ring": "0 0 0 var(--nb-focus-ring-offset) var(--vscode-editor-background), 0 0 0 calc(var(--nb-focus-ring-offset) + 1px) var(--nb-focus-contrast), 0 0 0 calc(var(--nb-focus-ring-offset) + 3px) color-mix(in oklch, var(--nb-focus) 45%, transparent)",
            // Active-state accent, used by tabs, selected rows, and badges. Tinted
            // toward the foreground so it never disappears on low-contrast palettes.
            "--nb-accent": "color-mix(in oklch, var(--nb-focus) 70%, var(--vscode-foreground) 30%)",
            "--nb-accent-soft": "color-mix(in oklch, var(--nb-focus) 16%, transparent)",
            "--nb-accent-ring": "color-mix(in oklch, var(--nb-focus) 55%, var(--vscode-foreground) 45%)",
            "background-color": "var(--nb-canvas) !important",
            "font-family": "var(--nb-font-ui) !important",
            "-webkit-font-smoothing": "antialiased",
            "text-rendering": "optimizeLegibility"
        },
        // ------------------------------------------------------------------
        // B. Dark Theme Depth & Material Physics
        // ------------------------------------------------------------------
        ".monaco-workbench.vs-dark, .vs-dark .monaco-workbench": {
            "--nb-canvas": "color-mix(in oklch, var(--vscode-activityBar-background, var(--vscode-sideBar-background)) 86%, #000 14%)",
            "--nb-surface": "var(--vscode-sideBar-background)",
            "--nb-surface-raised": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
            "--nb-surface-elevated": "color-mix(in oklch, var(--vscode-editorWidget-background) 86%, var(--vscode-foreground) 14%)",
            "--nb-surface-highlight": "color-mix(in oklch, var(--vscode-foreground) 10%, transparent)",
            "--nb-surface-active": "color-mix(in oklch, var(--nb-focus) 18%, var(--nb-surface))",
            "--nb-pill": "color-mix(in oklch, var(--nb-canvas) 72%, var(--nb-surface) 28%)",
            "--nb-pill-hover": "color-mix(in oklch, var(--nb-canvas) 58%, var(--nb-surface) 42%)",
            "--nb-glass-n": "color-mix(in oklch, var(--vscode-foreground) 12%, transparent)",
            "--nb-glass-s": "color-mix(in oklch, var(--vscode-foreground) 6%, transparent)",
            "--nb-border": "color-mix(in oklch, var(--vscode-widget-border, var(--vscode-foreground)) 26%, transparent)",
            "--nb-border-soft": "color-mix(in oklch, var(--vscode-foreground) 13%, transparent)",
            "--nb-border-subtle": "color-mix(in oklch, var(--vscode-foreground) 7%, transparent)",
            "--nb-surface-shadow": "0 4px 16px color-mix(in srgb, var(--vscode-widget-shadow, #000) 36%, transparent)",
            "--nb-widget-shadow": "0 24px 64px -8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 52%, transparent), 0 4px 18px color-mix(in srgb, var(--vscode-widget-shadow, #000) 24%, transparent)",
            "--nb-shadow-spotlight": "0 32px 72px -10px color-mix(in srgb, var(--vscode-widget-shadow, #000) 65%, transparent), 0 8px 24px -4px color-mix(in srgb, var(--vscode-widget-shadow, #000) 30%, transparent)",
            "--nb-shadow-soft": "0 2px 8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 28%, transparent)",
            "--nb-pill-shadow": "inset 0 1px 2px color-mix(in srgb, var(--vscode-foreground) 10%, transparent), 0 1px 4px color-mix(in srgb, #000 32%, transparent)",
            "--nb-glass-blur": "blur(8px) saturate(125%)",
            "--nb-blur-strong": "blur(12px) saturate(135%)",
            "--nb-tab-surface-inactive": "color-mix(in oklch, var(--vscode-sideBar-background) 80%, transparent)",
            "--nb-tab-border-inactive": "color-mix(in srgb, var(--vscode-foreground) 22%, transparent)",
            "--nb-tab-border-hover": "color-mix(in oklch, var(--nb-focus) 70%, transparent)",
            "--nb-tab-outline": "color-mix(in srgb, var(--vscode-foreground) 45%, transparent)"
        },
        // ------------------------------------------------------------------
        // C. Light Theme Parchment & Porcelain Optics
        // ------------------------------------------------------------------
        ".monaco-workbench.vs, .vs .monaco-workbench": {
            "--nb-canvas": "color-mix(in oklch, var(--vscode-sideBar-background) 92%, var(--vscode-foreground) 8%)",
            "--nb-surface": "var(--vscode-sideBar-background)",
            "--nb-surface-raised": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
            "--nb-surface-elevated": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
            "--nb-surface-highlight": "color-mix(in oklch, var(--vscode-foreground) 6%, transparent)",
            "--nb-surface-active": "color-mix(in oklch, var(--nb-focus) 12%, var(--nb-surface))",
            "--nb-pill": "color-mix(in oklch, var(--nb-canvas) 80%, var(--nb-surface) 20%)",
            "--nb-pill-hover": "color-mix(in oklch, var(--nb-canvas) 65%, var(--nb-surface) 35%)",
            "--nb-glass-n": "color-mix(in oklch, var(--vscode-foreground) 8%, transparent)",
            "--nb-glass-s": "color-mix(in oklch, var(--vscode-foreground) 6%, transparent)",
            "--nb-border": "color-mix(in oklch, var(--vscode-foreground) 16%, transparent)",
            "--nb-border-soft": "color-mix(in oklch, var(--vscode-foreground) 12%, transparent)",
            "--nb-border-subtle": "color-mix(in oklch, var(--vscode-foreground) 6%, transparent)",
            // Shadows and gloss are derived from theme tokens rather than pure
            // black/white, so warm light palettes (Solarized Light, Rosé Pine
            // Dawn) keep their hue instead of picking up a neutral white streak.
            "--nb-surface-shadow": "0 2px 10px color-mix(in srgb, var(--vscode-widget-shadow, #000) 6%, transparent), 0 1px 3px color-mix(in srgb, var(--vscode-widget-shadow, #000) 4%, transparent)",
            "--nb-widget-shadow": "0 20px 48px -8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 14%, transparent), 0 4px 14px color-mix(in srgb, var(--vscode-widget-shadow, #000) 6%, transparent)",
            "--nb-shadow-spotlight": "0 24px 54px -8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 18%, transparent), 0 6px 18px color-mix(in srgb, var(--vscode-widget-shadow, #000) 8%, transparent)",
            "--nb-shadow-soft": "0 2px 6px color-mix(in srgb, var(--vscode-widget-shadow, #000) 5%, transparent)",
            "--nb-pill-shadow": "inset 0 1px 2px color-mix(in srgb, var(--vscode-editorWidget-background, var(--vscode-sideBar-background)) 80%, transparent), 0 1px 3px color-mix(in srgb, var(--vscode-widget-shadow, #000) 6%, transparent)",
            "--nb-tab-surface-inactive": "color-mix(in oklch, var(--vscode-foreground) 4%, var(--nb-surface-raised))",
            "--nb-tab-border-inactive": "color-mix(in srgb, var(--vscode-foreground) 25%, transparent)",
            "--nb-tab-border-hover": "color-mix(in oklch, var(--nb-focus) 70%, transparent)",
            "--nb-tab-outline": "color-mix(in srgb, var(--vscode-foreground) 50%, transparent)"
        },
        // ------------------------------------------------------------------
        // D. High Contrast Mode
        // ------------------------------------------------------------------
        ".monaco-workbench.hc-black, .monaco-workbench.hc-light": {
            "--nb-glass-blur": "none",
            "--nb-blur-strong": "none",
            "--nb-border": "var(--vscode-contrastBorder, CanvasText)",
            "--nb-border-soft": "var(--vscode-contrastBorder, CanvasText)",
            "--nb-border-subtle": "var(--vscode-contrastBorder, CanvasText)"
        },
        // ------------------------------------------------------------------
        // E. Global Typography & Shell UI
        // ------------------------------------------------------------------
        ".part.sidebar, .part.auxiliarybar, .part.panel, .part.activitybar, .part.statusbar, .command-center-center, .tabs-and-actions-container, .monaco-breadcrumbs, .monaco-menu, .quick-input-widget, .suggest-widget, .notifications-center, .notification-toast": {
            "font-family": "var(--nb-font-ui) !important"
        },
        ".monaco-list-row, .monaco-menu .action-label, .quick-input-widget, .suggest-widget, .settings-editor": {
            "font-size": "var(--nb-font-size-ui) !important"
        },
        ".part.statusbar, .monaco-breadcrumbs": {
            "font-size": "var(--nb-font-size-small) !important"
        },
        ".part.sidebar .title-label, .part.auxiliarybar .title-label, .part.panel.bottom .title-label": {
            "font-family": "var(--nb-font-heading) !important",
            "font-weight": "700",
            "font-size": "var(--nb-font-size-heading) !important",
            "letter-spacing": "var(--nb-letter-spacing-heading)"
        },
        ".part.sidebar .title-label h2": {
            "font-family": "var(--nb-font-heading) !important",
            "font-size": "var(--nb-font-size-heading) !important",
            "font-weight": "700",
            "text-transform": "uppercase",
            "letter-spacing": "var(--nb-letter-spacing-heading)"
        },
        // ------------------------------------------------------------------
        // F. Window Titlebar & Command Center Spotlight Pill
        // ------------------------------------------------------------------
        ".part.titlebar": {
            "background-color": "var(--nb-canvas) !important",
            "border-bottom": "1px solid var(--nb-border-subtle) !important",
            "height": "34px !important",
            "min-height": "34px !important",
            "box-shadow": "none",
            "transition": "none"
        },
        ".part.titlebar .action-label": {
            "border-radius": "var(--nb-radius-item)",
            "transition": "var(--nb-transition-ui)"
        },
        ".command-center-center": {
            "border-radius": "var(--nb-radius-pill)",
            "overflow": "hidden",
            "border": "1px solid var(--nb-border-subtle)",
            "background": "color-mix(in oklch, var(--vscode-foreground) 4%, transparent)",
            "box-shadow": "none",
            "padding": "0 6px",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".command-center-center:hover": {
            "background": "color-mix(in oklch, var(--vscode-foreground) 8%, transparent) !important",
            "border-color": "var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-shadow-xs)"
        },
        ".command-center-center :is(button, .action-item)": {
            "border-radius": "var(--nb-radius-sm)"
        },
        ".command-center-center .codicon-search": {
            "opacity": "0.9 !important",
            "font-size": "var(--nb-font-size-ui) !important",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".command-center-center:hover .codicon-search": {
            "opacity": "1 !important"
        },
        // ------------------------------------------------------------------
        // G. Activity Bar (Minimal Dock Rail)
        // ------------------------------------------------------------------
        ".part.activitybar": {
            "margin": "var(--nb-panel-top) 0 var(--nb-panel-bottom) var(--nb-panel-gap) !important",
            "border-radius": "var(--nb-radius-panel)",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-surface-shadow)",
            "background-color": "var(--vscode-activityBar-background, var(--nb-surface)) !important",
            "width": "42px !important",
            "min-width": "38px !important",
            "box-sizing": "border-box",
            "overflow": "hidden",
            "background-image": "none !important",
            "transition": "var(--nb-transition-ui)"
        },
        ".part.activitybar .content": {
            "width": "100% !important",
            "height": "100% !important",
            "display": "flex !important",
            "flex-direction": "column !important",
            "justify-content": "space-between !important",
            "align-items": "center !important",
            "box-sizing": "border-box"
        },
        ".part.activitybar :is(.composite-bar, .global-actions)": {
            "background": "transparent !important",
            "border": "none",
            "box-shadow": "none",
            "width": "100% !important",
            "margin": "0",
            "box-sizing": "border-box",
            "display": "flex !important",
            "flex-direction": "column !important",
            "align-items": "center !important"
        },
        ".part.activitybar .composite-bar": {
            "border-radius": "0",
            "padding": "4px 0 !important"
        },
        ".part.activitybar .global-actions": {
            "padding": "4px 0 6px 0 !important"
        },
        ".part.activitybar .actions-container": {
            "align-items": "center !important",
            "justify-content": "center !important",
            "width": "100% !important",
            "overflow": "visible !important",
            "gap": "3px !important"
        },
        ".part.activitybar .action-item": {
            "display": "flex !important",
            "justify-content": "center !important",
            "align-items": "center !important",
            "width": "100% !important",
            "margin": "1px auto !important",
            "padding": "0 !important",
            "overflow": "visible !important",
            "border-radius": "0",
            "background": "transparent",
            "box-shadow": "none"
        },
        ".part.activitybar .action-item .action-label": {
            "font-size": "20px !important",
            "color": "var(--vscode-activityBar-inactiveForeground, var(--vscode-activityBar-foreground)) !important",
            "opacity": "0.88 !important",
            "width": "30px !important",
            "height": "30px !important",
            "line-height": "30px !important",
            "border": "1px solid transparent",
            "border-radius": "var(--nb-radius-item)",
            "display": "flex !important",
            "align-items": "center !important",
            "justify-content": "center !important",
            "overflow": "visible !important",
            "transition": "color var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.activitybar .action-item .action-label .codicon": {
            "font-size": "20px !important"
        },
        ".part.activitybar .action-item .action-label img": {
            "max-width": "18px !important",
            "max-height": "18px !important"
        },
        ".part.activitybar .action-item .active-item-indicator": {
            "display": "none !important"
        },
        ".part.activitybar .action-item:hover .action-label": {
            "background-color": "var(--nb-surface-highlight) !important",
            "opacity": "1 !important"
        },
        ".part.activitybar .action-item.checked .action-label": {
            "color": "var(--vscode-activityBar-foreground, var(--vscode-foreground)) !important",
            "opacity": "1 !important",
            "background-color": "color-mix(in oklch, var(--nb-focus) 18%, var(--nb-surface)) !important",
            "border": "1px solid color-mix(in oklch, var(--nb-focus) 35%, transparent) !important",
            "border-radius": "var(--nb-radius-item)",
            "width": "30px !important",
            "height": "30px !important",
            "box-shadow": "0 2px 8px color-mix(in oklch, var(--nb-focus) 20%, transparent)"
        },
        ".part.activitybar .badge": {
            "z-index": "10 !important",
            "overflow": "visible !important",
            "transform": "scale(0.85) translate(2px, -2px) !important",
            "transform-origin": "top right !important"
        },
        // ------------------------------------------------------------------
        // H. Floating Island Containers (Sidebar, Auxiliary Bar, Editor)
        // ------------------------------------------------------------------
        ".part.sidebar, .part.auxiliarybar, .part.editor": {
            "margin": "var(--nb-panel-top) var(--nb-panel-gap) var(--nb-panel-bottom) var(--nb-panel-gap) !important",
            "min-height": "0",
            "border-radius": "var(--nb-radius-panel)",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-surface-shadow)",
            "box-sizing": "border-box"
        },
        // Sidebar and auxiliary bar can clip content safely (overflow hidden for border-radius)
        ".part.sidebar, .part.auxiliarybar": {
            "overflow": "hidden",
            "background-color": "var(--vscode-sideBar-background, var(--nb-surface)) !important",
            "background-image": "none !important"
        },
        // Editor uses overflow: visible so Peek Definition, Peek References,
        // and the Find widget are never clipped at the editor boundary.
        // Rounded corners are handled by inner .editor-group-container.
        ".part.editor": {
            "overflow": "visible",
            "background-color": "var(--vscode-editor-background) !important",
            "background-image": "none !important",
            "transition": "none",
            "isolation": "isolate"
        },
        ".monaco-workbench.linux .part.editor > .content": {
            "padding-top": "0 !important"
        },
        // ------------------------------------------------------------------
        // I. Explorer Tree, Lists & Sidebar Panes
        // ------------------------------------------------------------------
        ".part.sidebar .composite.title": {
            "padding": "8px 10px 0 2px !important"
        },
        // Sidebar padding for all panes.
        // The search viewlet's replace-row action buttons collapse into "..."
        // when horizontal space is too tight — removing the 8px side padding
        // when the content hosts the search view fixes it. The search view
        // already manages its own internal margins via .search-widgets-container.
        ".part.sidebar .content": {
            "width": "100% !important",
            "padding-left": "8px !important",
            "padding-right": "8px !important",
            "margin-left": "0 !important",
            "box-sizing": "border-box"
        },
        // Fix #10: restore 4px side padding for search view so inputs don't
        // render flush to the sidebar border (was 0, now 4px each side).
        ".part.sidebar .content:has(.search-view)": {
            "padding-left": "4px !important",
            "padding-right": "4px !important"
        },
        // Fix: VS Code's .replace-container uses inline-flex which sizes to content
        // rather than filling the parent width. The ActionBar then sees a narrow
        // container and collapses Replace + Replace All into the "..." overflow menu.
        // Switching to flex + width:100% (minus the 18px left margin) ensures the
        // replace row spans the full widget width and the action buttons always show.
        ".search-view .search-widget .replace-container": {
            "display": "flex !important",
            "width": "calc(100% - 18px) !important",
            "align-items": "center"
        },
        ".search-view .search-widget .replace-input": {
            "flex": "1 1 auto !important",
            "min-width": "0 !important"
        },
        ".search-view .search-widget .replace-container .monaco-action-bar": {
            "flex-shrink": "0 !important"
        },
        ".part.sidebar .welcome-view-content": {
            "max-width": "100% !important",
            "box-sizing": "border-box"
        },
        ".part.sidebar .pane-header": {
            "border-radius": "var(--nb-radius-item)",
            "outline-offset": "-1px !important",
            "padding": "4px 8px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.sidebar .pane-header:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".part.sidebar .header": {
            "padding-right": "8px !important"
        },
        ".part.sidebar .label-name": {
            "font-size": "var(--nb-font-size-ui) !important"
        },
        ".part.sidebar .pane-header .title": {
            "font-size": "var(--nb-font-size-heading) !important",
            "font-weight": "600",
            "letter-spacing": "var(--nb-letter-spacing-heading)",
            "text-transform": "uppercase"
        },
        ".extensions-search-container .suggest-input-container": {
            "font-size": "var(--nb-font-size-heading) !important",
            "--editor-font-size": "11px !important"
        },
        ".extensions-search-container .suggest-input-placeholder": {
            "font-size": "var(--nb-font-size-heading) !important"
        },
        ".explorer-viewlet .split-view-container": {
            "margin-top": "0 !important"
        },
        ".explorer-folders-view .monaco-tl-row": {
            "padding-block": "0 !important"
        },
        ".part.sidebar .monaco-list-row": {
            // Fix #11: reduced from 0 4px / calc(100% - 8px) to 0 2px / calc(100% - 4px)
            // so long paths in SCM, Extensions, and Search aren't over-truncated.
            "margin": "0 2px !important",
            "width": "calc(100% - 4px) !important",
            "border-radius": "var(--nb-radius-item)",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.sidebar .monaco-list-row.selected": {
            "background-color": "var(--vscode-list-inactiveSelectionBackground, var(--nb-surface-highlight)) !important",
            "color": "var(--vscode-list-inactiveSelectionForeground, inherit) !important",
            "box-shadow": "inset 2px 0 0 var(--nb-accent), inset 0 0 0 1px var(--nb-accent-soft) !important"
        },
        ".part.sidebar .monaco-list-row.focused": {
            "background-color": "var(--vscode-list-focusBackground, var(--nb-surface-highlight)) !important",
            "color": "var(--vscode-list-focusForeground, inherit) !important",
            "box-shadow": "inset 2px 0 0 var(--nb-accent-ring), inset 0 0 0 1px var(--nb-focus-contrast) !important"
        },
        ".part.sidebar .monaco-list-row:hover:not(.selected):not(.focused)": {
            "background-color": "var(--vscode-list-hoverBackground, var(--nb-surface-highlight)) !important"
        },
        ".monaco-tl-twistie": {
            "transition": "transform var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)",
            "opacity": "0.8"
        },
        ".monaco-list-row:hover .monaco-tl-twistie": {
            "opacity": "1 !important"
        },
        ".monaco-tl-indent": {
            "opacity": "1 !important"
        },
        ".monaco-tl-indent > .indent-guide": {
            "border-left-width": "1px !important",
            "border-left-style": "solid !important",
            "opacity": "0.75",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out), border-color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 1)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground1, var(--vscode-editorBracketHighlight-foreground1, #73ade9)) !important"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 2)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground2, var(--vscode-editorBracketHighlight-foreground2, #b477cf)) !important"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 3)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground3, var(--vscode-editorBracketHighlight-foreground3, #dfc184)) !important"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 4)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground4, var(--vscode-editorBracketHighlight-foreground4, #a1c181)) !important"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 5)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground5, var(--vscode-editorBracketHighlight-foreground5, #6eb4bf)) !important"
        },
        ".monaco-tl-indent > .indent-guide:nth-child(6n + 6)": {
            "border-left-color": "var(--vscode-editorBracketPairGuide-activeBackground6, var(--vscode-editorBracketHighlight-foreground6, #d07277)) !important"
        },
        ".part.sidebar .monaco-list-row:is(:hover, .focused, .selected) .monaco-tl-indent > .indent-guide": {
            "opacity": "0.9 !important"
        },
        ".part.sidebar .monaco-list-row:is(:hover, .focused, .selected) .monaco-tl-indent > .indent-guide:last-child": {
            "opacity": "1 !important",
            "border-left-width": "1.5px !important"
        },
        // ------------------------------------------------------------------
        // J. Auxiliary Bar (Secondary Panes)
        // ------------------------------------------------------------------
        ".part.auxiliarybar .composite.title": {
            "padding": "8px 0 0 8px !important"
        },
        ".part.auxiliarybar .header": {
            "padding-left": "8px !important"
        },
        // ------------------------------------------------------------------
        // K. Tabs & Tab Strip (Floating Rounded Capsule Cards)
        // ------------------------------------------------------------------
        ".editor-group-header": {
            "background-color": "var(--vscode-editorGroupHeader-tabsBackground, var(--nb-canvas)) !important",
            "border-bottom": "1px solid var(--vscode-editorGroupHeader-tabsBorder, var(--nb-border-subtle)) !important"
        },
        // Scroll decoration restored — it's the only visual cue that tabs
        // have scrolled and more exist to the left. Dimmed to be subtle.
        ".editor-group-header .scroll-decoration": {
            "opacity": "0.4",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".editor-group-header:hover .scroll-decoration": {
            "opacity": "1"
        },
        ".tabs-and-actions-container": {
            "background-color": "transparent",
            "border-bottom": "none",
            "min-height": "36px !important",
            "height": "36px !important",
            "padding": "0 6px",
            "box-sizing": "border-box",
            "display": "flex",
            "align-items": "center"
        },
        ".editor-actions": {
            "background-image": "none",
            "border-bottom": "none",
            "display": "flex",
            "align-items": "center",
            "gap": "2px",
            "padding-right": "8px"
        },
        ".editor-actions .action-label": {
            "border-radius": "var(--nb-radius-item)",
            "padding": "3px 5px",
            "opacity": "0.88",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".editor-actions .action-label:hover": {
            "opacity": "1",
            "background-color": "var(--nb-surface-highlight)"
        },
        ".editor-actions .action-label:active": {
            "transform": "scale(0.94)"
        },
        ".tabs-container": {
            "background-image": "none",
            "border-bottom": "none",
            "scrollbar-width": "none",
            "display": "flex",
            "align-items": "center",
            "gap": "4px"
        },
        // Hidden at rest for aesthetics, thin bar appears on hover so users
        // know tabs overflow and can scroll to find hidden files.
        ".tabs-container::-webkit-scrollbar": {
            "height": "3px",
            "display": "none"
        },
        ".tabs-container:hover::-webkit-scrollbar": {
            "display": "block"
        },
        ".tab": {
            "position": "relative",
            "font-family": "var(--nb-font-ui)",
            "font-size": "var(--nb-font-size-ui)",
            "height": "28px !important",
            "min-height": "28px !important",
            "max-height": "28px !important",
            "margin": "0 2px",
            "box-sizing": "border-box",
            "border": "1px solid var(--nb-tab-border-inactive)",
            "border-radius": "var(--nb-radius-tab)",
            "box-shadow": "none",
            "background-color": "var(--nb-tab-surface-inactive, var(--vscode-tab-inactiveBackground))",
            "color": "var(--vscode-tab-inactiveForeground, var(--vscode-foreground))",
            "opacity": "1",
            "display": "flex",
            "align-items": "center",
            "padding": "0 10px",
            "cursor": "pointer",
            "user-select": "none",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), border-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".tab::before, .tab::after, .tab-border-top-container, .tab-border-bottom-container": {
            "display": "none !important"
        },
        ".tab:first-child::before, .tab.active::before, .tab:hover::before, .tab.active + .tab::before, .tab:hover + .tab::before": {
            "display": "none !important"
        },
        ".tab:hover:not(.active)": {
            "background-color": "var(--vscode-tab-hoverBackground, var(--nb-surface-highlight))",
            "border-color": "var(--nb-tab-border-hover)",
            "color": "var(--vscode-tab-hoverForeground, var(--vscode-foreground))",
            "opacity": "1"
        },
        ".tab.active": {
            "position": "relative",
            "z-index": "2",
            "background-color": "var(--vscode-tab-activeBackground, var(--vscode-editor-background))",
            "color": "var(--vscode-tab-activeForeground, var(--vscode-foreground))",
            "font-weight": "500",
            "opacity": "1",
            "border": "1px solid var(--nb-tab-outline)",
            "border-radius": "var(--nb-radius-tab)",
            "box-shadow": "var(--nb-shadow-xs), inset 0 1px 0 var(--nb-glass-n), inset 0 2px 0 var(--nb-accent)"
        },
        ".tab.active:hover": {
            "border-color": "var(--nb-tab-border-hover)",
            "background-color": "var(--vscode-tab-activeBackground, var(--vscode-editor-background))"
        },
        ".tab.active.focused": {
            "border-color": "var(--nb-accent-ring)",
            "box-shadow": "var(--nb-shadow-sm), inset 0 2px 0 var(--nb-accent)"
        },
        ".tab.selected:not(.active)": {
            "background-color": "color-mix(in oklch, var(--nb-focus) 18%, var(--nb-tab-surface-inactive)) !important",
            "border-color": "var(--nb-accent-ring) !important",
            "color": "var(--vscode-tab-activeForeground, var(--vscode-foreground)) !important",
            "opacity": "1"
        },
        ".editor-group-container:not(.active) .tab.active": {
            "background-color": "var(--vscode-tab-unfocusedActiveBackground, var(--vscode-tab-activeBackground))",
            "color": "var(--vscode-tab-unfocusedActiveForeground, var(--vscode-foreground))",
            "font-weight": "500",
            "border": "1px solid var(--nb-tab-border-inactive)",
            "border-radius": "var(--nb-radius-tab)",
            "box-shadow": "none",
            "transform": "none"
        },
        ".tab .tab-label": {
            "height": "100% !important",
            "display": "flex !important",
            "align-items": "center !important",
            "gap": "6px !important",
            "min-width": "0 !important",
            "overflow": "hidden !important"
        },
        ".tab .label-name": {
            "font-size": "var(--nb-font-size-small) !important",
            "white-space": "nowrap !important",
            "overflow": "hidden !important",
            "text-overflow": "ellipsis !important",
            "line-height": "normal !important",
            "letter-spacing": "0.01em !important"
        },
        ".tab .label-description": {
            "font-size": "var(--nb-font-size-small) !important",
            "opacity": "0.6",
            "margin-left": "2px"
        },
        ".tab .monaco-icon-label.file-icon::before": {
            "font-size": "15px !important",
            "width": "16px !important",
            "height": "16px !important",
            "display": "inline-flex !important",
            "align-items": "center !important",
            "justify-content": "center !important",
            "vertical-align": "middle !important",
            "transform": "translateY(-0.5px) !important"
        },
        ".tab :is(.tab-actions, .monaco-action-bar)": {
            "background": "transparent !important",
            "background-image": "none !important",
            "display": "flex !important",
            "align-items": "center !important",
            "justify-content": "center !important",
            "margin-left": "4px !important"
        },
        ".tab :is(.tab-actions, .tab-close-action)": {
            "opacity": "0 !important",
            "transition": "opacity var(--nb-motion-fast) var(--nb-ease-out), transform var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".tab:is(.active, :hover, :focus-within) :is(.tab-actions, .tab-close-action)": {
            "opacity": "0.7 !important"
        },
        // Fix #7: keyboard focus on a tab also reveals the close button
        ".tab:focus-visible :is(.tab-actions, .tab-close-action)": {
            "opacity": "0.7 !important"
        },
        ".tab:is(.active, :hover, :focus-within) :is(.tab-actions, .tab-close-action):hover": {
            "opacity": "1 !important"
        },
        ".tab :is(.tab-actions .action-label, .tab-close-action)": {
            "width": "20px !important",
            "height": "20px !important",
            "display": "flex !important",
            "align-items": "center !important",
            "justify-content": "center !important",
            "border-radius": "var(--nb-radius-pill)",
            "border": "none",
            "padding": "0",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".tab :is(.tab-actions .action-label, .tab-close-action):hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".tab :is(.tab-actions .action-label, .tab-close-action):active": {
            "transform": "scale(0.92) !important"
        },
        ".tab :is(.dirty, .codicon-modifier-modified)": {
            "color": "var(--vscode-tab-activeModifiedBorder, #e5c07b) !important",
            "opacity": "1 !important"
        },
        ".tab:focus-visible": {
            "outline": "none !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-focus-contrast) !important"
        },
        ".tab.pinned": {
            "min-width": "35px !important",
            "max-width": "35px !important",
            "width": "35px !important",
            "padding": "0 !important",
            "justify-content": "center !important"
        },
        ".tab.pinned .tab-label": {
            "justify-content": "center !important",
            "gap": "0 !important",
            "padding": "0 !important"
        },
        ".tab.pinned .label-name, .tab.pinned .label-description": {
            "display": "none !important"
        },
        ".tab.pinned:not(:has(.dirty)):not(:has(.codicon-modifier-modified)) :is(.tab-actions, .tab-close-action)": {
            "display": "none !important"
        },
        ".tab.pinned:is(:has(.dirty), :has(.codicon-modifier-modified)) :is(.tab-actions, .tab-close-action)": {
            "display": "flex !important",
            "opacity": "1 !important"
        },
        ".tab.last-pinned-tab": {
            "margin-right": "0",
            "position": "relative !important",
            "border-right": "1px solid var(--vscode-tab-lastPinnedBorder, var(--vscode-tab-border, var(--nb-border-subtle))) !important"
        },
        ".tab.last-pinned-tab::after": {
            "display": "none !important"
        },
        ".editor-group-container .tabs-container": {
            "opacity": "1 !important"
        },
        // Fix #8: dirty dot (unsaved indicator) always renders at full opacity
        // even when inactive group tab bar is dimmed to 0.85.
        ".editor-group-container .tabs-container .tab :is(.dirty, .codicon-modifier-modified)": {
            "opacity": "1 !important"
        },
        // ------------------------------------------------------------------
        // L. Breadcrumbs, Minimap & Sticky Scroll
        // ------------------------------------------------------------------
        ".minimap canvas": {
            "opacity": "1 !important",
            "transition": "opacity var(--nb-motion-slow) var(--nb-ease-out)"
        },
        ".minimap:is(:hover, :focus-within) canvas": {
            "opacity": "1 !important"
        },
        ".monaco-breadcrumbs": {
            "border-top": "none !important",
            "border-bottom": "1px solid var(--nb-border-subtle) !important",
            "padding": "0 8px !important",
            "opacity": "1 !important",
            "transition": "opacity var(--nb-motion-base) var(--nb-ease-out)"
        },
        ".monaco-breadcrumbs:is(:hover, :focus-within)": {
            "opacity": "1 !important"
        },
        ".monaco-breadcrumbs .monaco-breadcrumb-item": {
            "border-radius": "var(--nb-radius-sm)",
            "padding": "1px 4px",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".monaco-breadcrumbs .monaco-breadcrumb-item:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".sticky-widget": {
            "background-color": "var(--vscode-editor-background) !important",
            "border-bottom": "1px solid var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-shadow-sm) !important"
        },
        // ------------------------------------------------------------------
        // M. Bottom Panel & Integrated Terminal
        // ------------------------------------------------------------------
        ".part.panel.bottom": {
            "background-color": "var(--vscode-panel-background, var(--nb-surface)) !important",
            "margin-top": "var(--nb-panel-top) !important",
            "border-inline": "var(--nb-panel-gap) solid var(--nb-canvas) !important",
            "border-block": "none !important",
            "border-radius": "var(--nb-radius-panel)",
            "box-shadow": "var(--nb-glass-inset), var(--nb-surface-shadow) !important",
            "box-sizing": "border-box",
            "overflow": "hidden",
            "transition": "var(--nb-transition-ui)"
            // isolation: isolate removed — it trapped terminal overlay z-index
            // within the panel stacking context, hiding autocomplete above editor.
        },
        ".part.panel.bottom > .composite.title": {
            "position": "relative !important",
            "z-index": "1 !important",
            "padding": "4px 8px !important",
            "border-bottom": "1px solid var(--nb-border-subtle) !important"
        },
        ".part.panel.bottom > .composite.title .action-label": {
            "border-radius": "var(--nb-radius-item)",
            "padding": "2px 6px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), opacity var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.panel.bottom > .content": {
            "margin-top": "0 !important",
            "position": "relative !important",
            "border-radius": "0 0 calc(var(--nb-radius-panel) - var(--nb-panel-gap)) calc(var(--nb-radius-panel) - var(--nb-panel-gap))",
            "overflow": "hidden"
        },
        ".part.panel.bottom :is(.pane, .pane-body, .split-view-view, .composite, .monaco-pane-view, .output-view)": {
            "border-bottom": "none !important"
        },
        ".part.panel.bottom .terminal-outer-container": {
            "border-left": "1px solid var(--nb-border-subtle) !important",
            "border-radius": "0 0 0 var(--nb-radius-panel)",
            "box-sizing": "border-box",
            "overflow": "hidden",
            "isolation": "isolate"
        },
        ".part.panel.bottom .terminal.xterm": {
            "border-radius": "0 0 0 var(--nb-radius-panel)",
            "padding": "4px 6px !important"
        },
        ".part.panel.bottom .terminal-tabs-entry": {
            "border-radius": "var(--nb-radius-item)",
            "margin": "2px 4px !important",
            "padding": "4px 8px !important",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.panel.bottom .terminal-tabs-entry:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".part.panel.bottom .terminal-tabs-entry.has-focus, .part.panel.bottom .terminal-tabs-entry:focus": {
            "background-color": "var(--vscode-list-focusBackground, var(--nb-surface-active)) !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-focus) !important"
        },
        ".part.panel.bottom .terminal-split-pane-divider": {
            "background-color": "var(--nb-border-subtle) !important"
        },
        ".part.panel.bottom :is(.message-box-container, .welcome-view-content)": {
            "border-radius": "var(--nb-radius-item)",
            "margin": "4px !important",
            "width": "calc(100% - 8px) !important",
            "box-sizing": "border-box"
        },
        // ------------------------------------------------------------------
        // N. Command Palette, Quick Pick & Frosted Glass Modals
        // ------------------------------------------------------------------
        // overflow:clip provides visual border-radius clipping without creating
        // a scroll container or BFC — inner sub-menus and dropdowns can escape.
        ".quick-input-widget, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
            "border-radius": "var(--nb-radius-widget)",
            "background-color": "var(--nb-surface-raised) !important",
            "overflow": "clip",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-shadow-spotlight), var(--nb-glass-inset) !important",
            "backdrop-filter": "var(--nb-blur-strong) !important",
            "-webkit-backdrop-filter": "var(--nb-blur-strong) !important"
        },
        // overflow:clip here too — hover cards with wide code blocks are
        // no longer silently truncated. VS Code manages internal scroll itself.
        ".suggest-widget, .monaco-hover": {
            "border-radius": "var(--nb-radius-widget)",
            "background-color": "var(--vscode-editorWidget-background, var(--nb-surface-raised)) !important",
            "overflow": "clip",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-widget-shadow) !important"
        },
        ".quick-input-widget, .monaco-dialog-box, .notifications-center, .monaco-menu": {
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both"
        },
        ".quick-input-widget": {
            "padding": "4px !important"
        },
        ".quick-input-widget .quick-input-header": {
            "padding": "6px 8px !important",
            "border-bottom": "1px solid var(--nb-border-subtle) !important"
        },
        ".quick-input-widget .monaco-inputbox": {
            "border": "1px solid var(--nb-border-subtle) !important",
            "border-radius": "var(--nb-radius-card) !important",
            "box-shadow": "inset 0 1px 2px color-mix(in srgb, #000 8%, transparent) !important",
            "outline": "none !important",
            "background": "color-mix(in oklch, var(--vscode-input-background, var(--vscode-editor-background)) 92%, var(--vscode-foreground) 8%) !important",
            "font-size": "14px !important",
            "padding": "7px 10px !important",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".quick-input-widget .monaco-inputbox.focused": {
            "border-color": "var(--nb-focus) !important",
            "box-shadow": "var(--nb-focus-ring) !important"
        },
        ".quick-input-widget .monaco-list-row": {
            "margin": "1px 4px !important",
            "width": "calc(100% - 8px) !important",
            "border-radius": "var(--nb-radius-item)",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".quick-input-widget .monaco-list-row.focused, .suggest-widget .monaco-list-row.focused": {
            "background": "var(--vscode-list-focusBackground, var(--nb-surface-active)) !important",
            "color": "var(--vscode-list-focusForeground, inherit) !important",
            "box-shadow": "inset 2px 0 0 var(--nb-accent), inset 0 0 0 1px var(--nb-accent-soft), 0 1px 3px var(--nb-shadow-xs) !important"
        },
        ".monaco-keybinding, .keybinding, .command-center-keybinding": {
            "border-radius": "5px !important",
            "padding": "2px 6px !important",
            "font-size": "10.5px !important",
            "font-weight": "600",
            "line-height": "12px !important",
            "background": "color-mix(in oklch, var(--vscode-foreground) 7%, var(--nb-surface-raised)) !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "border-bottom": "2px solid color-mix(in oklch, var(--vscode-foreground) 24%, transparent) !important",
            "box-shadow": "0 1px 2px color-mix(in srgb, #000 15%, transparent) !important",
            "display": "inline-flex",
            "align-items": "center"
        },
        ".monaco-keybinding .monaco-keybinding-key, .keybinding .monaco-keybinding-key": {
            "padding": "0 1px"
        },
        // ------------------------------------------------------------------
        // O. Suggestion Details, Hover Cards & Documentation
        // ------------------------------------------------------------------
        ".suggest-widget .suggest-details": {
            "border-radius": "var(--nb-radius-widget)",
            "border": "1px solid var(--nb-border-soft)",
            "background-color": "var(--nb-surface-raised) !important",
            "box-shadow": "var(--nb-widget-shadow), var(--nb-glass-inset) !important",
            "padding": "8px 12px"
        },
        ".monaco-hover": {
            "border-radius": "var(--nb-radius-widget)",
            "padding": "6px 10px"
        },
        ".monaco-hover :is(pre, code)": {
            "border-radius": "var(--nb-radius-sm)",
            "background-color": "color-mix(in oklch, var(--vscode-foreground) 8%, transparent) !important",
            "padding": "2px 5px",
            "font-family": "var(--nb-font-mono) !important",
            "font-size": "var(--nb-font-size-small) !important"
        },
        ".monaco-hover a:not(.monaco-button):not([role='button'])": {
            "color": "var(--vscode-textLink-foreground, var(--nb-focus)) !important",
            "text-decoration": "none"
        },
        ".monaco-hover a:not(.monaco-button):not([role='button']):hover": {
            "color": "var(--vscode-textLink-activeForeground, var(--nb-focus)) !important",
            "text-decoration": "underline"
        },
        ".monaco-hover :is(.monaco-button, a.monaco-button, [role='button'])": {
            "color": "var(--vscode-button-foreground) !important",
            "background-color": "var(--vscode-button-background) !important"
        },
        ".monaco-hover :is(.monaco-button.secondary, a.monaco-button.secondary)": {
            "color": "var(--vscode-button-secondaryForeground) !important",
            "background-color": "var(--vscode-button-secondaryBackground) !important"
        },
        // ------------------------------------------------------------------
        // P. Notification Toasts & Notification Center
        // ------------------------------------------------------------------
        ".notification-toast": {
            "border-radius": "var(--nb-radius-card)",
            "animation": "nb-toast-in var(--nb-motion-slow) var(--nb-ease-out) both",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-widget-shadow), var(--nb-glass-inset) !important"
        },
        ".notifications-toasts": {
            "margin-right": "var(--nb-panel-gap) !important",
            "margin-bottom": "var(--nb-panel-gap) !important"
        },
        ".notification-toast .notification-toast-content": {
            "padding": "10px 14px"
        },
        ".notifications-center": {
            "border-radius": "var(--nb-radius-widget)",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-widget-shadow), var(--nb-glass-inset) !important",
            "overflow": "hidden"
        },
        ".notifications-center .notifications-center-header": {
            "padding": "8px 12px",
            "border-bottom": "1px solid var(--nb-border-subtle)",
            "background-color": "color-mix(in oklch, var(--vscode-foreground) 4%, transparent) !important"
        },
        ".notifications-center .notification-list-item": {
            "border-radius": "var(--nb-radius-item)",
            "margin": "2px 6px",
            "border-bottom": "1px solid var(--nb-border-subtle)",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".notifications-center .notification-list-item:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        // ------------------------------------------------------------------
        // Q. Context Menus & Popups
        // ------------------------------------------------------------------
        ".monaco-menu .monaco-action-bar .action-item": {
            "border-radius": "var(--nb-radius-sm)",
            "margin": "2px 4px",
            "transition": "var(--nb-transition-ui)"
        },
        ".monaco-menu .monaco-action-bar .action-item.focused": {
            "background-color": "var(--nb-surface-highlight) !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-border-hover) !important"
        },
        // ------------------------------------------------------------------
        // R. Settings Editor Card Architecture
        // ------------------------------------------------------------------
        ".settings-editor .setting-item": {
            "border-radius": "var(--nb-radius-card)",
            "border": "1px solid var(--nb-border-soft)",
            "background-color": "var(--nb-surface) !important",
            "padding": "14px 18px",
            "margin-bottom": "8px",
            "box-shadow": "var(--nb-shadow-xs)",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".settings-editor .setting-item-contents": {
            "border": "0",
            "background-color": "transparent",
            "padding": "0",
            "box-shadow": "none"
        },
        ".settings-editor .setting-item:hover": {
            "border-color": "var(--nb-focus) !important",
            "background-color": "var(--nb-surface-highlight) !important",
            "box-shadow": "var(--nb-shadow-md)"
        },
        ".settings-editor .setting-item.setting-item-modified .setting-item-contents": {
            "border-left": "3px solid var(--vscode-settings-modifiedItemIndicator) !important"
        },
        // ------------------------------------------------------------------
        // S. Form Controls, Inputs & Button States
        // ------------------------------------------------------------------
        ".viewpane-filter .monaco-inputbox, .scm-editor, .scm-input, .part.sidebar .monaco-button": {
            "border-radius": "var(--nb-radius-input)",
            "overflow": "hidden"
        },
        ".monaco-inputbox": {
            "border-radius": "var(--nb-radius-input)",
            "border": "1px solid var(--nb-border-soft)",
            "background-color": "var(--vscode-input-background)",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".monaco-inputbox.focused, .scm-input:focus-within, .scm-editor:focus-within": {
            "border-color": "var(--nb-focus)",
            "box-shadow": "var(--nb-focus-ring)"
        },
        ".monaco-button, a.monaco-button, .monaco-text-button": {
            "border-radius": "var(--nb-radius-input)",
            "border": "1px solid transparent",
            "color": "var(--vscode-button-foreground) !important",
            "background-color": "var(--vscode-button-background) !important",
            "transition": "var(--nb-transition-ui), transform var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".monaco-button:hover, a.monaco-button:hover, .monaco-text-button:hover": {
            "border-color": "var(--nb-border-hover)",
            "box-shadow": "var(--nb-shadow-soft)",
            "color": "var(--vscode-button-foreground) !important"
        },
        ".monaco-button.secondary, a.monaco-button.secondary": {
            "color": "var(--vscode-button-secondaryForeground) !important",
            "background-color": "var(--vscode-button-secondaryBackground) !important"
        },
        ".monaco-button:active, .action-label:active": {
            "transform": "scale(0.98)"
        },
        // Theme-aware keyboard focus for interactive controls only. The dual-ring
        // token keeps the indicator visible even when a theme defines a fully
        // transparent focusBorder or button background.
        ".monaco-workbench :is(button, [role='button'], [role='tab'], input, textarea, select, [tabindex]:not([tabindex='-1'])):focus-visible": {
            "box-shadow": "var(--nb-ring) !important",
            "outline": "none !important",
            "border-radius": "var(--nb-radius-item)"
        },
        ".monaco-workbench :is(input, textarea, [role='textbox']):focus-visible": {
            "outline": "none",
            "box-shadow": "var(--nb-ring)"
        },
        ".monaco-list-row": {
            "border-radius": "var(--nb-radius-item)",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".monaco-list-row:hover": {
            "background-color": "var(--nb-surface-highlight)",
            "box-shadow": "inset 0 0 0 1px var(--nb-border-subtle)"
        },
        ".monaco-workbench :focus-visible.monaco-list-row, .monaco-list-row:focus-visible": {
            "box-shadow": "inset 0 0 0 1px var(--nb-focus-contrast) !important",
            "outline": "1px solid var(--nb-focus-contrast) !important",
            "outline-offset": "-1px"
        },
        // ------------------------------------------------------------------
        // T. Status Bar Dock & System Dynamic Island Micro-Badges
        // ------------------------------------------------------------------
        ".part.statusbar": {
            "background-color": "var(--vscode-statusBar-background, var(--nb-canvas)) !important",
            "border-top": "1px solid var(--nb-border-subtle) !important",
            "border-radius": "var(--nb-radius-widget) var(--nb-radius-widget) 0 0",
            "box-sizing": "border-box",
            "box-shadow": "none",
            "padding": "0 6px !important",
            "font-family": "var(--nb-font-ui)",
            "transition": "var(--nb-transition-ui)"
        },
        ".part.statusbar .items-container": {
            "display": "flex",
            "align-items": "center",
            "height": "100%",
            "gap": "2px"
        },
        ".part.statusbar .statusbar-item": {
            "border-radius": "var(--nb-radius-pill) !important",
            "padding": "1px 8px !important",
            "margin": "3px 2px !important",
            "height": "calc(100% - 6px) !important",
            "background-color": "color-mix(in oklch, var(--vscode-statusBar-background, var(--nb-canvas)) 88%, var(--vscode-foreground) 12%) !important",
            "border": "1px solid var(--nb-border) !important",
            "box-shadow": "inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent), 0 1px 2px color-mix(in srgb, #000 16%, transparent) !important",
            "color": "var(--vscode-statusBar-foreground, var(--vscode-foreground)) !important",
            "font-size": "var(--nb-font-size-small)",
            "font-weight": "500",
            "display": "inline-flex",
            "align-items": "center",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), border-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out), transform var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.statusbar .statusbar-item:hover": {
            "background-color": "var(--nb-surface-highlight) !important",
            "border-color": "var(--nb-border-hover) !important",
            "box-shadow": "var(--nb-shadow-xs) !important",
            "transform": "translateY(-0.5px)"
        },
        ".part.statusbar .statusbar-item:active": {
            "background-color": "var(--nb-surface-active) !important",
            "transform": "scale(0.96)"
        },
        ".part.statusbar :is(.statusbar-item-label, .codicon)": {
            "opacity": "1 !important",
            "transition": "color var(--nb-motion-fast) var(--nb-ease-out)"
        },
        ".part.statusbar .statusbar-item:has(.codicon-error)": {
            "background-color": "color-mix(in oklch, var(--vscode-statusBarItem-errorBackground, #e51400) 22%, transparent)",
            "border": "1px solid color-mix(in oklch, var(--vscode-statusBarItem-errorBackground, #e51400) 45%, transparent)",
            "color": "var(--vscode-statusBarItem-errorForeground, inherit)"
        },
        ".part.statusbar .statusbar-item:has(.codicon-warning)": {
            "background-color": "color-mix(in oklch, var(--vscode-statusBarItem-warningBackground, #cca700) 20%, transparent)",
            "border": "1px solid color-mix(in oklch, var(--vscode-statusBarItem-warningBackground, #cca700) 40%, transparent)",
            "color": "var(--vscode-statusBarItem-warningForeground, inherit)"
        },
        // ------------------------------------------------------------------
        // U. Scrollbars, Sashes, Badges & Minimap
        // ------------------------------------------------------------------
        ".scrollbar .slider": {
            "border-radius": "var(--nb-radius-pill)",
            "transition": "opacity 0.25s var(--nb-ease-soft), width 0.2s var(--nb-ease-out), height 0.2s var(--nb-ease-out), background-color 0.2s var(--nb-ease-out)"
        },
        ".monaco-scrollable-element > .scrollbar.vertical": {
            "width": "14px !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider": {
            "background": "color-mix(in oklch, var(--vscode-scrollbarSlider-background) 75%, var(--nb-focus) 25%)"
        },
        ".monaco-scrollable-element > .scrollbar.vertical > .slider": {
            "width": "6px !important",
            "margin-left": "4px !important"
        },
        ".monaco-scrollable-element > .scrollbar.vertical:hover > .slider": {
            "width": "8px !important",
            "margin-left": "3px !important"
        },
        ".monaco-scrollable-element > .scrollbar.horizontal > .slider": {
            "height": "6px !important",
            "margin-top": "4px !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:hover": {
            "background": "var(--vscode-scrollbarSlider-hoverBackground)",
            "box-shadow": "0 0 0 2px color-mix(in oklch, var(--nb-focus) 25%, transparent)"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:active": {
            "background": "var(--vscode-scrollbarSlider-activeBackground)",
            "box-shadow": "0 0 0 2px color-mix(in oklch, var(--nb-focus) 40%, transparent)"
        },
        ".monaco-count-badge": {
            "border-radius": "var(--nb-radius-pill)",
            "font-size": "var(--nb-font-size-small)",
            "font-weight": "600",
            "padding": "1px 7px",
            "min-height": "16px",
            "line-height": "16px",
            "border": "1px solid var(--nb-border-subtle)",
            "box-shadow": "var(--nb-shadow-xs)"
        },
        ".monaco-sash": {
            "z-index": "40",
            "transition": "background-color var(--nb-motion-fast) var(--nb-ease-out), box-shadow var(--nb-motion-fast) var(--nb-ease-out)"
        },
        // Fix #13: reduced from 12px to 6px — still easy to grab but no longer
        // intercepts clicks near panel edges intended for nearby content.
        ".monaco-sash.vertical": {
            "width": "6px !important",
            "margin-left": "-3px !important"
        },
        ".monaco-sash.horizontal": {
            "height": "6px !important",
            "margin-top": "-3px !important"
        },
        ".monaco-sash:hover": {
            "background-color": "color-mix(in oklch, var(--nb-focus) 35%, transparent)",
            "box-shadow": "none"
        },
        ".monaco-sash.active, .monaco-sash:active": {
            "background-color": "var(--nb-focus)",
            "box-shadow": "0 0 8px var(--nb-focus)"
        },
        ".monaco-editor .margin": {
            "border-right": "1px solid var(--nb-border-subtle)"
        },
        // Fix #14: animation: none removed — cursor animation is controlled by
        // editor.cursorBlinking in settings ("solid" = no animation). Keeping
        // animation: none here would silently override any future setting change.
        ".monaco-editor .cursor": {
            "filter": "none"
        },
        ":is(.monaco-workbench.vs-dark, .vs-dark) .monaco-icon-label.file-icon::before": {
            "opacity": "1"
        },
        // ------------------------------------------------------------------
        // V. Find Widgets (Editor Floating Spotlight & Terminal)
        // ------------------------------------------------------------------
        ".editor-widget.find-widget": {
            "top": "8px !important",
            "right": "16px !important",
            "border-radius": "var(--nb-radius-card) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-widget-shadow), var(--nb-glass-inset) !important",
            "padding": "6px 8px !important"
        },
        ".editor-widget.find-widget .monaco-inputbox": {
            "border-radius": "var(--nb-radius-input) !important"
        },
        ".terminal-find-widget": {
            "border-radius": "var(--nb-radius-widget)",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border-soft)",
            "box-shadow": "var(--nb-widget-shadow)",
            "padding": "4px 8px !important"
        },
        // ------------------------------------------------------------------
        // W. Keyframe Animations & Easing Curves
        // ------------------------------------------------------------------
        "@keyframes nb-settle-in": {
            "from": {
                "opacity": "0",
                "transform": "translateY(4px) scale(0.995)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateY(0) scale(1)"
            }
        },
        "@keyframes nb-toast-in": {
            "from": {
                "opacity": "0",
                "transform": "translateX(10px) scale(0.98)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateX(0) scale(1)"
            }
        },
        "@keyframes nb-progress-sweep": {
            "0%": {
                "opacity": "0",
                "transform": "translateX(-100%)"
            },
            "40%": {
                "opacity": "1"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateX(100%)"
            }
        },
        // ------------------------------------------------------------------
        // X. Media Queries & Accessibility Adaptations
        // ------------------------------------------------------------------
        // X0. color-mix() fallback for older VS Code builds.
        // The declared engine range (^1.60) predates color-mix() support
        // (Chromium 111 / VS Code ~1.82). Without this, every surface token
        // derived from color-mix() would resolve to nothing and the chrome
        // would render as transparent blocks. These are plain-token
        // equivalents of the base layer, so the UI stays coherent.
        "@supports not (color: color-mix(in srgb, red 50%, blue))": {
            // Selector repeats the theme variants so the fallback outranks the
            // higher-specificity .vs-dark / .vs / .hc-* token blocks above.
            // Both the element-class and ancestor-class forms are covered,
            // because VS Code has used each across versions.
            ".monaco-workbench, .monaco-workbench.vs-dark, .monaco-workbench.vs, .monaco-workbench.hc-black, .monaco-workbench.hc-light, .vs-dark .monaco-workbench, .vs .monaco-workbench": {
                "--nb-canvas": "var(--vscode-activityBar-background, var(--vscode-sideBar-background))",
                "--nb-surface": "var(--vscode-sideBar-background)",
                "--nb-surface-raised": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
                "--nb-surface-elevated": "var(--vscode-editorWidget-background, var(--vscode-sideBar-background))",
                "--nb-surface-highlight": "var(--vscode-list-hoverBackground, var(--vscode-toolbar-hoverBackground))",
                "--nb-surface-active": "var(--vscode-list-activeSelectionBackground, var(--vscode-list-focusBackground))",
                "--nb-pill": "var(--vscode-sideBar-background)",
                "--nb-pill-hover": "var(--vscode-list-hoverBackground, var(--vscode-sideBar-background))",
                "--nb-glass-n": "var(--vscode-widget-border, transparent)",
                "--nb-glass-s": "transparent",
                "--nb-glass-inset": "none",
                "--nb-border": "var(--vscode-widget-border, var(--vscode-panel-border, transparent))",
                "--nb-border-soft": "var(--vscode-widget-border, var(--vscode-panel-border, transparent))",
                "--nb-border-subtle": "var(--vscode-widget-border, var(--vscode-panel-border, transparent))",
                "--nb-border-hover": "var(--vscode-focusBorder, var(--vscode-foreground))",
                "--nb-tab-surface-inactive": "transparent",
                "--nb-tab-border-inactive": "var(--vscode-tab-border, transparent)",
                "--nb-tab-border-hover": "var(--vscode-focusBorder, var(--vscode-foreground))",
                "--nb-tab-outline": "var(--vscode-tab-border, transparent)",
                "--nb-shadow-xs": "none",
                "--nb-shadow-sm": "none",
                "--nb-shadow-md": "none",
                "--nb-shadow-xl": "none",
                "--nb-surface-shadow": "none",
                "--nb-widget-shadow": "none",
                "--nb-shadow-soft": "none",
                "--nb-pill-shadow": "none",
                "--nb-glass-blur": "none",
                "--nb-blur-strong": "none",
                "--nb-focus": "var(--vscode-focusBorder, var(--vscode-button-background, var(--vscode-foreground)))",
                "--nb-focus-contrast": "var(--vscode-foreground)",
                "--nb-focus-ring": "0 0 0 1px var(--nb-focus-contrast)",
                "--nb-ring": "0 0 0 var(--nb-focus-ring-offset) var(--nb-focus-contrast)",
                "--nb-accent": "var(--vscode-focusBorder, var(--vscode-foreground))",
                "--nb-accent-soft": "var(--vscode-focusBorder, transparent)",
                "--nb-accent-ring": "var(--vscode-focusBorder, var(--vscode-foreground))"
            },
            // Keybindings and status badges also tint with color-mix().
            ".monaco-keybinding, .keybinding, .command-center-keybinding": {
                "background-color": "var(--vscode-keybindingLabel-background) !important",
                "border": "1px solid var(--vscode-keybindingLabel-border, transparent)",
                "box-shadow": "none"
            },
            ".part.statusbar .statusbar-item:has(.codicon-error)": {
                "background-color": "var(--vscode-statusBarItem-errorBackground, transparent) !important",
                "border": "none"
            },
            ".part.statusbar .statusbar-item:has(.codicon-warning)": {
                "background-color": "var(--vscode-statusBarItem-warningBackground, transparent) !important",
                "border": "none"
            },
            ".tab.selected:not(.active)": {
                "background-color": "var(--vscode-tab-activeBackground, transparent) !important"
            }
        },
        "@media (max-width: 900px)": {
            ".monaco-workbench": {
                "--nb-panel-gap": "4px",
                "--nb-panel-top": "4px",
                "--nb-panel-bottom": "4px",
                "--nb-radius-panel": "10px",
                "--nb-radius-card": "8px",
                "--nb-radius-widget": "8px",
                "--nb-radius-tab": "9px",
                "--nb-radius-input": "4px",
                "--nb-radius-item": "3px"
            },
            ".part.activitybar": {
                "width": "38px !important"
            },
            ".tabs-and-actions-container": {
                "height": "36px !important",
                "padding": "0 4px"
            },
            ".tab": {
                "height": "28px !important",
                "padding": "0 8px"
            }
        },
        "@media (prefers-reduced-transparency: reduce)": {
            ".monaco-workbench": {
                "--nb-glass-blur": "none",
                "--nb-blur-strong": "none",
                "--nb-surface": "var(--vscode-sideBar-background)",
                "--nb-surface-raised": "var(--vscode-editorWidget-background)",
                "--nb-surface-elevated": "var(--vscode-editorWidget-background)"
            },
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu, .sticky-widget": {
                "backdrop-filter": "none",
                "-webkit-backdrop-filter": "none"
            }
        },
        "@media (prefers-reduced-motion: no-preference)": {
            ".quick-input-widget, .monaco-dialog-box": {
                "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both"
            },
            ".notification-toast": {
                "animation": "nb-toast-in var(--nb-motion-slow) var(--nb-ease-out) both"
            },
            ".monaco-progress-container.active .progress-bit": {
                "animation": "nb-progress-sweep 1.4s var(--nb-ease-out) infinite"
            }
        },
        "@media (prefers-reduced-motion: reduce)": {
            "*, *::before, *::after": {
                "animation-duration": "0.01ms !important",
                "animation-iteration-count": "1 !important",
                "transition-duration": "0.01ms !important",
                "scroll-behavior": "auto !important"
            }
        },
        "@media (prefers-contrast: more)": {
            ".part:is(.sidebar, .auxiliarybar, .activitybar, .statusbar, .editor), .part.panel.bottom, .tab, .quick-input-widget, .suggest-widget, .monaco-hover, .notification-toast": {
                "border": "1.5px solid var(--vscode-contrastBorder, CanvasText) !important",
                "box-shadow": "none !important"
            },
            // Mirrors the base focus selector; the box-shadow ring is dropped in
            // favour of a hard outline because the rules above remove shadows.
            ".monaco-workbench :is(button, [role='button'], [role='tab'], input, textarea, select, [tabindex]:not([tabindex='-1'])):focus-visible": {
                "outline": "2px solid CanvasText !important",
                "outline-offset": "2px !important",
                "box-shadow": "none !important"
            }
        },
        "@media (forced-colors: active)": {
            "*, *::before, *::after": {
                "box-shadow": "none !important"
            },
            ".part:is(.sidebar, .auxiliarybar, .activitybar, .statusbar, .editor), .part.panel.bottom, .tab": {
                "border": "1px solid CanvasText !important"
            },
            ":is(.monaco-breadcrumbs, .part.statusbar .statusbar-item-label, .minimap canvas)": {
                "opacity": "1 !important"
            },
            // The universal box-shadow reset above would delete the shadow-based
            // focus ring, so restore an outline-based indicator in this mode.
            ":is(.monaco-workbench) :is(button, [role='button'], [role='tab'], input, textarea, select, [tabindex]:not([tabindex='-1'])):focus-visible": {
                "outline": "2px solid Highlight !important",
                "outline-offset": "1px !important",
                "box-shadow": "none !important"
            },
            ".monaco-list-row.focused, .monaco-list-row.selected": {
                "outline": "1px solid Highlight !important",
                "outline-offset": "-1px !important"
            },
            ".tab.active": {
                "border": "1px solid Highlight !important",
                "box-shadow": "none !important"
            }
        }
    },
    // ======================================================================
    // 14. CSS authoring — native color tools, modern syntax, and quiet linting
    // ----------------------------------------------------------------------
    // Uses VS Code's built-in CSS language service. No formatter extension is
    // prescribed so users can retain Prettier, Stylelint, or a team formatter.
    // Modern CSS guidance: prefer @layer for cascade control, @container for
    // component responsiveness, and :where() when reducing selector specificity.
    // ======================================================================
    "editor.colorDecorators": true,
    "editor.colorDecoratorsLimit": 500,
    "css.validate": true,
    "css.hover.documentation": true,
    "css.hover.references": true,
    "css.completion.completePropertyWithSemicolon": true,
    "css.completion.triggerPropertyValueCompletion": true,
    "css.lint.emptyRules": "warning",
    "css.lint.duplicateProperties": "warning",
    "css.lint.zeroUnits": "warning",
    "css.lint.unknownAtRules": "ignore",
    "css.lint.compatibleVendorPrefixes": "ignore",
    "emmet.showExpandedAbbreviation": "always",
    "emmet.includeLanguages": {
        "postcss": "css"
    },
    // ======================================================================
    // 15. Language-specific settings
    // ======================================================================
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.colorDecorators": true,
        "editor.foldingStrategy": "auto",
        "editor.suggest.showWords": false
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.formatOnType": false,
        "editor.formatOnPaste": false,
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "on",
            "other": "off"
        }
    },
    "markdown.preview.fontFamily": "'Lilex', 'JetBrains Mono', 'JetBrainsMono Nerd Font', 'IBM Plex Mono', 'Monaspace Neon', 'Fira Code', 'Menlo', 'Monaco', monospace",
    "markdown.preview.fontSize": 15,
    "markdown.preview.lineHeight": 1.6,
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    // ======================================================================
    // 16. Modern VS Code features — AI assistance, diff, testing, notebooks
    // ----------------------------------------------------------------------
    // Inlay hints and ghost text for AI assistance
    // Diff editor enhanced presentation
    // Notebook interactive cell ergonomics
    // Breadcrumbs and quick-open navigation
    // ======================================================================
    "editor.ghostText.enabled": true,
    "workbench.editor.inlineSuggest.support.enabled": true,
    "diffEditor.overviewRulerBorder": true,
    "notebook.stickyScroll.enabled": true
}
