{
    // Firefox NOVA uses compact chrome; keep the editor comfortably readable.
    "window.zoomLevel": 1.25,
    // ======================================================================
    // Tab management
    // ======================================================================
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.editor.tabActionUnpinVisibility": true,
    // ======================================================================
    // Quick navigation
    // ======================================================================
    "workbench.quickOpen.closeOnFocusLost": true,
    "workbench.quickOpen.preserveInput": true,
    // ======================================================================
    // 1. Window, startup, and focus behavior
    // ----------------------------------------------------------------------
    // Firefox NOVA shell: soft organic geometry and compact density.
    // Theme colors remain controlled by the selected VS Code theme.
    // ======================================================================
    "zenMode.centerLayout": false,
    "zenMode.fullScreen": false,
    "zenMode.hideActivityBar": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    "zenMode.restore": true,
    "workbench.startupEditor": "welcomePage",
    "workbench.iconTheme": "material-icon-theme",
    "window.autoDetectColorScheme": true,
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${appName}",
    "window.titleBarStyle": "custom",
    "window.commandCenter": true,
    "workbench.layoutControl.enabled": false,
    "window.restoreWindows": "all",
    // ======================================================================
    // 2. Editor scrollbar and minimap
    // ----------------------------------------------------------------------
    // Thin floating rails; minimap slider always visible, canvas fades until hover.
    // ======================================================================
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.verticalScrollbarSize": 14,
    "editor.scrollbar.horizontalScrollbarSize": 12,
    "editor.minimap.enabled": true,
    "editor.minimap.side": "right",
    "editor.minimap.scale": 1,
    "editor.minimap.size": "proportional",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.maxColumn": 120,
    "editor.minimap.showSlider": "always",
    // ======================================================================
    // 3. Editor behavior and typography
    // ----------------------------------------------------------------------
    // Long-session comfort. Clear text, generous leading, and low motion.
    // ======================================================================
    "editor.fontFamily": "'IBM Plex Mono', 'JetBrains Mono', 'JetBrainsMono Nerd Font', 'Monaspace Neon', 'Fira Code', 'Menlo', 'Monaco', monospace",
    "editor.fontSize": 16,
    "editor.fontWeight": "400",
    "editor.lineHeight": 1.8,
    "editor.letterSpacing": 0.15,
    "editor.fontLigatures": "'calt', 'liga'",
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.cursorWidth": 2,
    "editor.mouseWheelZoom": false,
    "editor.padding.top": 16,
    "editor.padding.bottom": 20,
    "editor.smoothScrolling": false,
    "editor.scrollBeyondLastColumn": 3,
    "editor.scrollPredominantAxis": true,
    "editor.fastScrollSensitivity": 5,
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.cursorSurroundingLines": 8,
    "editor.cursorSurroundingLinesStyle": "default",
    "editor.scrollBeyondLastLine": false,
    "editor.wordWrap": "off",
    "editor.wrappingIndent": "same",
    "editor.renderLineHighlight": "line",
    "editor.renderFinalNewline": "dimmed",
    "editor.renderWhitespace": "selection",
    "editor.renderControlCharacters": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.dragAndDrop": true,
    "editor.stickyTabStops": true,
    "editor.largeFileOptimizations": true,
    "editor.accessibilitySupport": "auto",
    "accessibility.signalOptions.volume": "off",
    // Eye-care: less constant glow, clear column anchors, calmer highlights.
    "editor.matchBrackets": "near",
    "editor.occurrencesHighlight": "singleFile",
    "editor.selectionHighlight": true,
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    // Formatting and save actions.
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    // Unicode safety.
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.nonBasicASCII": false,
    // ======================================================================
    // 4. Suggestions, hints, hover, and code navigation
    // ======================================================================
    "editor.suggest.preview": true,
    "editor.suggest.previewMode": "prefix",
    "editor.suggest.insertMode": "replace",
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggestSelection": "recentlyUsedByPrefix",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.suggest.localityBonus": true,
    "editor.suggest.showStatusBar": true,
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.showToolbar": "onHover",
    "editor.inlineSuggest.suppressSuggestions": false,
    "editor.parameterHints.enabled": true,
    "editor.parameterHints.cycle": true,
    "editor.linkedEditing": true,
    "editor.hover.enabled": "on",
    "editor.hover.delay": 300,
    "editor.hover.sticky": true,
    "editor.codeLens": false,
    "editor.codeLensFontSize": 14,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.inlayHints.fontSize": 14,
    "editor.inlayHints.padding": true,
    "editor.inlayHints.maximumLength": 40,
    // ======================================================================
    // 5. Indent guides, bracket guides, and sticky scroll
    // ----------------------------------------------------------------------
    // Native Indent Rainbow: six cycling hues provided directly by each theme
    // so nested blocks are readable at a glance. Guides stay on across all
    // indent columns; the active column and matching bracket pair render stronger.
    // ======================================================================
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": "always",
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": "active",
    "editor.guides.highlightActiveBracketPair": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 3,
    // ======================================================================
    // 6. Breadcrumbs
    // ======================================================================
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    "breadcrumbs.icons": true,
    "breadcrumbs.showArrays": true,
    "breadcrumbs.showBooleans": true,
    "breadcrumbs.showClasses": true,
    "breadcrumbs.showConstants": true,
    "breadcrumbs.showConstructors": true,
    "breadcrumbs.showEnumMembers": true,
    "breadcrumbs.showEnums": true,
    "breadcrumbs.showFields": true,
    "breadcrumbs.showFiles": true,
    "breadcrumbs.showFunctions": true,
    "breadcrumbs.showInterfaces": true,
    "breadcrumbs.showMethods": true,
    "breadcrumbs.showModules": true,
    "breadcrumbs.showObjects": true,
    "breadcrumbs.showPackages": true,
    "breadcrumbs.showProperties": true,
    "breadcrumbs.showStructs": true,
    "breadcrumbs.showVariables": true,
    // ======================================================================
    // 7. Workbench tabs and editor management
    // ----------------------------------------------------------------------
    // Firefox Nova tabs: separated, rounded browser tabs with a quiet strip,
    // a raised active surface, and controls that appear on intent.
    // ======================================================================
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.reduceMotion": "user",
    "workbench.editor.emptyWindowText": "off",
    "workbench.settings.useSplitJSON": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.pinnedTabsOnSeparateRow": false,
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.tabCloseButton": "right",
    "workbench.editor.alwaysShowEditorActions": false,
    "workbench.editor.showIcons": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.labelFormat": "short",
    "workbench.editor.restoreViewState": true,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.decorations.colors": true,
    "workbench.editor.decorations.badges": true,
    "workbench.editor.focusRecentEditorAfterClose": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.closeEmptyGroups": true,
    "workbench.editor.splitSizing": "split",
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    "editor.dimUnfocusedEditors": false,
    // ======================================================================
    // 8. Explorer / solution-view behavior
    // ======================================================================
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.expandMode": "singleClick",
    "workbench.list.smoothScrolling": true,
    "workbench.list.keyboardNavigation": "highlight",
    "explorer.autoReveal": "focusNoScroll",
    "explorer.incrementalNaming": "smart",
    "explorer.confirmDragAndDrop": true,
    "explorer.confirmDelete": true,
    "explorer.confirmPasteNative": false,
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lock, bun.lockb, .npmrc, .yarnrc.yml",
        "tsconfig.json": "tsconfig.*.json",
        "vite.config.*": "vitest.config.*, playwright.config.*, cypress.config.*",
        "next.config.*": "next-env.d.ts, middleware.*, instrumentation.*",
        "tailwind.config.*": "postcss.config.*, components.json",
        "eslint.config.*": ".eslintignore",
        "prettier.config.*": ".prettierignore",
        "README.md": "CHANGELOG.md, LICENSE, SECURITY.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md",
        "Dockerfile": ".dockerignore, docker-compose*.yml, compose*.yml",
        ".env": ".env.*, !.env.example"
    },
    // ======================================================================
    // 9. Search, files, excludes, and performance
    // ======================================================================
    "search.searchOnType": true,
    "search.showLineNumbers": true,
    "search.decorations.colors": true,
    "search.collapseResults": "auto",
    "search.smartCase": true,
    "search.useIgnoreFiles": true,
    "search.useGlobalIgnoreFiles": true,
    "search.quickOpen.includeSymbols": true,
    "search.searchEditor.doubleClickBehaviour": "goToLocation",
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    "files.simpleDialog.enable": false,
    "files.hotExit": "onExitAndWindowClose",
    "files.restoreUndoStack": true,
    "search.exclude": {
        "**/.angular": true,
        "**/.svelte-kit": true,
        "**/.astro": true,
        "**/.output": true,
        "**/.serverless": true,
        "**/.pnpm-store": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/.vscode": false,
        "**/.idea": true,
        "**/*.log": true,
        "**/coverage": true,
        ".pytest_cache": true,
        "__pycache__": true,
        "**/__pycache__": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.parcel-cache": true
    },
    "files.watcherExclude": {
        "**/.angular/**": true,
        "**/.svelte-kit/**": true,
        "**/.astro/**": true,
        "**/.output/**": true,
        "**/.serverless/**": true,
        "**/.pnpm-store/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/**": true,
        "**/*.log": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.turbo/**": true,
        "**/.cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.tox/**": true,
        "**/.parcel-cache/**": true,
        "**/coverage/**": true
    },
    // ======================================================================
    // 10. Terminal
    // ======================================================================
    "terminal.integrated.minimumContrastRatio": 7,
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.scrollback": 20000,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', 'JetBrains Mono', 'JetBrainsMono Nerd Font', 'Fira Code', 'IBM Plex Mono', 'Monaspace Neon', 'Menlo', 'Monaco', monospace",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.fontWeight": "450",
    "terminal.integrated.lineHeight": 1.55,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": false,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.customGlyphs": true,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.hideCondition": "singleTerminal",
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.copyOnSelection": true,
    // ======================================================================
    // 11. Git, diff, merge, AI tools
    // ======================================================================
    "git.decorations.enabled": true,
    "git.autorefresh": true,
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    "git.showPushSuccessNotification": true,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "always",
    "git.pruneOnFetch": true,
    "git.branchProtectionPrompt": "alwaysPrompt",
    "scm.defaultViewMode": "tree",
    "scm.showHistoryGraph": true,
    "scm.alwaysShowRepositories": true,
    "scm.diffDecorations": "all",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "on",
    "diffEditor.hideUnchangedRegions.enabled": false,
    "diffEditor.showMoves": true,
    "diffEditor.diffAlgorithm": "advanced",
    "diffEditor.renderIndicators": true,
    "diffEditor.codeLens": true,
    "mergeEditor.enabled": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true,
        "python": true,
        "csharp": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "chat.agent.maxRequests": 50,
    "chat.detectParticipant.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.preferredLocation": "panel",
    // ======================================================================
    // 12. Problems panel
    // ======================================================================
    "problems.showWarnings": true,
    "problems.showInfos": true,
    "problems.showCurrentInStatus": true,
    "problems.decorations.enabled": true,
    "problems.autoReveal": false,
    "problems.sortOrder": "severity",
    // ======================================================================
    // 13. Custom UI stylesheet — Firefox NOVA chrome
    // ----------------------------------------------------------------------
    // Soft organic geometry, theme-aware surfaces, compact density, and subtle
    // focus treatments. Requires Custom UI Style extension.
    // ======================================================================
    "custom-ui-style.stylesheet": {
        ".monaco-workbench": {
            "--nb-font-ui": "'Bear Sans UI', sans-serif",
            "--nb-font-heading": "'Bear Sans UI Heading', sans-serif",
            "--nb-font-size-ui": "13px",
            "--nb-font-size-small": "12px",
            "--nb-font-size-heading": "12px",
            "--nb-radius-panel": "18px",
            "--nb-radius-widget": "16px",
            "--nb-radius-input": "16px",
            "--nb-radius-item": "10px",
            "--nb-radius-sm": "8px",
            "--nb-panel-gap": "5px",
            "--nb-panel-top": "5px",
            "--nb-canvas": "color-mix(in srgb, var(--vscode-activityBar-background, var(--vscode-sideBar-background)) 92%, var(--vscode-foreground) 8%)",
            "--nb-surface": "color-mix(in srgb, var(--vscode-sideBar-background) 94%, transparent)",
            "--nb-surface-raised": "color-mix(in srgb, var(--vscode-editorWidget-background) 96%, transparent)",
            "--nb-surface-elevated": "color-mix(in srgb, var(--vscode-editorWidget-background) 90%, var(--vscode-foreground) 10%)",
            "--nb-surface-highlight": "color-mix(in srgb, var(--vscode-foreground) 8%, transparent)",
            "--nb-surface-2": "color-mix(in srgb, var(--vscode-sideBar-background) 88%, var(--vscode-editor-background) 12%)",
            "--nb-pill": "color-mix(in srgb, var(--nb-canvas) 70%, var(--nb-surface) 30%)",
            "--nb-tab-seam": "transparent",
            // Firefox NOVA tab chrome: theme-aware surfaces, soft outlines, and
            // the same violet/blue accent used by the active theme.
            "--nb-border-soft": "color-mix(in oklch, var(--vscode-foreground) 15%, transparent)",
            "--nb-border-hover": "color-mix(in oklch, var(--vscode-focusBorder) 62%, transparent)",
            "--nb-tab-surface": "color-mix(in oklch, var(--vscode-tab-inactiveBackground, var(--nb-surface)) 94%, var(--vscode-editor-background) 6%)",
            "--nb-tab-active-surface": "var(--vscode-tab-activeBackground, var(--vscode-editor-background))",
            "--nb-tab-outline": "color-mix(in oklch, var(--vscode-foreground) 18%, transparent)",
            "--nb-tab-accent": "var(--vscode-tab-activeBorderTop, var(--vscode-focusBorder))",
            "--nb-tab-shadow": "0 2px 8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 26%, transparent)",
            "--nb-glass-n": "color-mix(in srgb, var(--vscode-foreground) 24%, transparent)",
            "--nb-glass-w": "color-mix(in srgb, var(--vscode-foreground) 16%, transparent)",
            "--nb-glass-s": "color-mix(in srgb, var(--vscode-foreground) 16%, transparent)",
            "--nb-glass-e": "color-mix(in srgb, var(--vscode-foreground) 16%, transparent)",
            "--nb-border": "color-mix(in srgb, var(--vscode-widget-border, var(--vscode-foreground)) 38%, transparent)",
            "--nb-border-subtle": "color-mix(in srgb, var(--vscode-widget-border, var(--vscode-foreground)) 20%, transparent)",
            "--nb-border-strong": "color-mix(in srgb, var(--vscode-widget-border, var(--vscode-foreground)) 52%, transparent)",
            "--nb-surface-shadow": "0 2px 8px color-mix(in srgb, var(--vscode-widget-shadow, #000) 28%, transparent)",
            "--nb-widget-shadow": "0 8px 24px color-mix(in srgb, var(--vscode-widget-shadow, #000) 40%, transparent)",
            "--nb-shadow-soft": "0 4px 12px color-mix(in srgb, var(--vscode-widget-shadow, #000) 22%, transparent)",
            "--nb-pill-shadow": "inset 0 1px 3px color-mix(in srgb, #fff 10%, transparent), 0 1px 4px color-mix(in srgb, #000 18%, transparent)",
            "--nb-glass-inset": "inset 0 1px 0 var(--nb-glass-n), inset 1px 0 0 var(--nb-glass-w), inset 0 -1px 0 var(--nb-glass-s), inset -1px 0 0 var(--nb-glass-e)",
            "--nb-glass-blur": "blur(12px)",
            "--nb-blur-strong": "blur(18px)",
            "--nb-motion-xs": "80ms",
            "--nb-motion-fast": "120ms",
            "--nb-motion-base": "180ms",
            "--nb-motion-slow": "260ms",
            "--nb-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
            "--nb-ease-in": "cubic-bezier(0.7, 0, 0.84, 0)",
            "--nb-ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
            "--nb-ease-soft": "cubic-bezier(0.4, 0, 0.2, 1)",
            "--nb-focus": "var(--vscode-focusBorder)",
            "--nb-accent-soft": "color-mix(in oklch, var(--nb-focus) 18%, transparent)",
            "--nb-accent-medium": "color-mix(in oklch, var(--nb-focus) 32%, transparent)",
            "--nb-focus-ring": "0 0 0 3px color-mix(in oklch, var(--nb-focus) 30%, transparent)",
            "--nb-focus-ring-offset": "2px",
            "--nb-transition-ui": "background-color var(--nb-motion-fast) var(--nb-ease-soft), border-color var(--nb-motion-fast) var(--nb-ease-soft), box-shadow var(--nb-motion-fast) var(--nb-ease-soft), color var(--nb-motion-fast) var(--nb-ease-soft)",
            "--nb-ring": "0 0 0 var(--nb-focus-ring-offset) var(--vscode-editor-background), 0 0 0 calc(var(--nb-focus-ring-offset) + 2px) var(--nb-focus)",
            "--nb-text-muted": "color-mix(in oklch, var(--vscode-foreground) 72%, transparent)",
            "--nb-text-faint": "color-mix(in oklch, var(--vscode-foreground) 52%, transparent)",
            "--nb-scrim": "color-mix(in oklch, var(--vscode-editor-background) 55%, transparent)",
            "--nb-spacing-xs": "4px",
            "--nb-spacing-sm": "8px",
            "--nb-spacing-md": "12px",
            "--nb-spacing-lg": "16px",
            "--nb-z-overlay": "1000",
            "background-color": "var(--nb-canvas) !important",
            "font-family": "var(--nb-font-ui) !important"
        },
        ".monaco-workbench.vs-dark, .vs-dark .monaco-workbench": {
            "--nb-canvas": "color-mix(in oklch, var(--vscode-activityBar-background, var(--vscode-sideBar-background)) 88%, var(--vscode-foreground) 12%)",
            "--nb-surface": "color-mix(in oklch, var(--vscode-sideBar-background) 94%, transparent)",
            "--nb-surface-raised": "color-mix(in oklch, var(--vscode-editorWidget-background) 92%, transparent)",
            "--nb-surface-elevated": "color-mix(in oklch, var(--vscode-editorWidget-background) 86%, var(--vscode-foreground) 14%)",
            "--nb-surface-highlight": "color-mix(in oklch, var(--vscode-foreground) 14%, transparent)",
            "--nb-pill": "color-mix(in srgb, var(--nb-canvas) 70%, var(--nb-surface) 30%)",
            "--nb-tab-seam": "transparent",
            "--nb-glass-n": "color-mix(in oklch, var(--vscode-foreground) 22%, transparent)",
            "--nb-glass-w": "color-mix(in oklch, var(--vscode-foreground) 14%, transparent)",
            "--nb-glass-s": "color-mix(in oklch, var(--vscode-foreground) 7%, transparent)",
            "--nb-glass-e": "color-mix(in oklch, var(--vscode-foreground) 7%, transparent)",
            "--nb-border": "color-mix(in oklch, var(--vscode-widget-border, var(--vscode-foreground)) 30%, transparent)",
