        ".search-widget .replace-container .action-label, .editor-widget.find-widget .action-label": {
            "opacity": "1 !important",
            "visibility": "visible !important"
        },
        ".monaco-inputbox, .monaco-findInput": {
            "border-radius": "var(--nb-radius-input) !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "background-color": "var(--vscode-input-background) !important",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-inputbox.focused, .monaco-findInput.focused, .scm-input:focus-within, .scm-editor:focus-within": {
            "border-color": "var(--nb-focus) !important",
            "box-shadow": "var(--nb-focus-ring) !important"
        },
        ".monaco-button": {
            "border-radius": "var(--nb-radius-input) !important",
            "border": "1px solid transparent !important",
            "transition": "var(--nb-transition-ui), transform var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-button:hover": {
            "border-color": "var(--nb-border-hover) !important",
            "box-shadow": "var(--nb-shadow-soft) !important"
        },
        ".monaco-button:active, .action-label:active": {
            "transform": "scale(0.98) !important"
        },
        ".monaco-workbench :focus-visible": {
            "outline": "2px solid var(--nb-focus) !important",
            "outline-offset": "var(--nb-focus-ring-offset) !important",
            "box-shadow": "var(--nb-focus-ring) !important",
            "border-radius": "var(--nb-radius-item) !important",
            "animation": "none !important"
        },
        ".monaco-workbench input:focus-visible, .monaco-workbench textarea:focus-visible, .monaco-workbench [role='textbox']:focus-visible": {
            "outline": "none !important",
            "box-shadow": "var(--nb-ring) !important"
        },
        ".command-center-center": {
            "font-family": "'Bear Sans UI', sans-serif !important",
            "border-radius": "9999px !important",
            "overflow": "hidden !important",
            "border": "1px solid var(--nb-border-subtle) !important",
            "background": "var(--nb-pill) !important",
            "box-shadow": "var(--nb-glass-inset), var(--nb-pill-shadow) !important",
            "transition": "box-shadow var(--nb-motion-base) var(--nb-ease-soft), background var(--nb-motion-base) var(--nb-ease-soft) !important"
        },
        ".command-center-center *": {
            "border-radius": "9999px !important"
        },
        ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "overflow": "hidden !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-widget-shadow), var(--nb-glass-inset) !important"
        },
        ".quick-input-widget, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
            "backdrop-filter": "var(--nb-glass-blur) !important",
            "-webkit-backdrop-filter": "var(--nb-glass-blur) !important"
        },
        ".quick-input-widget": {
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".suggest-widget, .monaco-hover": {
            "animation": "nb-settle-in var(--nb-motion-base) var(--nb-ease-out) both !important"
        },
        ".monaco-dialog-box, .notifications-center, .monaco-menu": {
            "animation": "nb-settle-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".notification-toast": {
            "animation": "nb-toast-in var(--nb-motion-slow) var(--nb-ease-out) both !important"
        },
        ".notifications-toasts": {
            "margin-right": "var(--nb-panel-gap) !important",
            "margin-bottom": "var(--nb-panel-gap) !important"
        },
        ".monaco-menu .monaco-action-bar .action-item": {
            "border-radius": "var(--nb-radius-sm) !important",
            "margin": "2px 4px !important",
            "transition": "var(--nb-transition-ui) !important"
        },
        ".monaco-menu .monaco-action-bar .action-item.focused": {
            "background-color": "var(--nb-surface-highlight) !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-border-hover) !important"
        },
        ".quick-input-widget .monaco-list-row": {
            "border-radius": "var(--nb-radius-item) !important",
            "margin-left": "4px !important",
            "margin-right": "4px !important",
            "width": "calc(100% - 8px) !important",
            "transition": "background 0.15s var(--nb-ease-soft) !important"
        },
        ".quick-input-widget .monaco-list-row.focused, .suggest-widget .monaco-list-row.focused": {
            "background": "linear-gradient(135deg, color-mix(in srgb, var(--vscode-foreground) 18%, transparent), color-mix(in srgb, var(--vscode-foreground) 10%, transparent)) !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-border-hover), var(--nb-shadow-soft) !important",
            "transform": "translateX(2px) !important"
        },
        ".monaco-dialog-box .dialog-buttons .monaco-button": {
            "border-radius": "var(--nb-radius-input) !important"
        },
        ".colorpicker-widget": {
            "border-radius": "var(--nb-radius-widget) !important",
            "background-color": "var(--nb-surface-raised) !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "overflow": "hidden !important"
        },
        ".settings-editor .setting-item": {
            "border-radius": "var(--nb-radius-widget) !important",
            "border": "1px solid var(--nb-border) !important",
            "background-color": "var(--nb-surface) !important",
            "padding": "14px 18px !important",
            "margin-bottom": "8px !important",
            "box-shadow": "none !important",
            "transition": "border-color var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".settings-editor .setting-item-contents": {
            "border": "0 !important",
            "background-color": "transparent !important",
            "padding": "0 !important",
            "box-shadow": "none !important"
        },
        ".settings-editor .setting-item:hover": {
            "border-color": "var(--vscode-focusBorder) !important",
            "background-color": "var(--nb-surface-highlight) !important",
            "box-shadow": "var(--nb-shadow-soft) !important",
            "transform": "translateY(-1px) !important"
        },
        ".settings-editor .setting-item.setting-item-modified .setting-item-contents": {
            "border-left": "3px solid var(--vscode-settings-modifiedItemIndicator) !important"
        },
        ".monaco-list-row": {
            "border-radius": "var(--nb-radius-item) !important",
            "transition": "var(--nb-transition-ui), transform var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-list-row:hover": {
            "background-color": "var(--nb-surface-highlight) !important",
            "box-shadow": "inset 0 0 0 1px var(--nb-border-subtle) !important"
        },
        ".monaco-workbench :focus-visible.monaco-list-row, .monaco-list-row:focus-visible": {
            "outline": "2px solid var(--nb-focus) !important",
            "outline-offset": "-2px !important"
        },
        ".monaco-progress-container .progress-bit": {
            "animation": "nb-progress-sweep 900ms var(--nb-ease-in-out) infinite !important"
        },
        ".scrollbar .slider": {
            "border-radius": "9999px !important",
            "transition": "opacity 0.3s var(--nb-ease-soft) !important"
        },
        ".monaco-scrollable-element > .scrollbar.vertical": {
            "width": "14px !important"
        },
        ".monaco-scrollable-element > .scrollbar.vertical > .slider": {
            "width": "6px !important",
            "margin-left": "4px !important",
            "border-radius": "999px !important",
            "background": "color-mix(in oklch, var(--vscode-scrollbarSlider-background) 72%, var(--nb-focus)) !important"
        },
        ".monaco-scrollable-element > .scrollbar.horizontal > .slider": {
            "height": "6px !important",
            "margin-top": "4px !important",
            "border-radius": "999px !important",
            "background": "color-mix(in oklch, var(--vscode-scrollbarSlider-background) 72%, var(--nb-focus)) !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:hover": {
            "background": "var(--vscode-scrollbarSlider-hoverBackground) !important",
            "box-shadow": "0 0 0 2px color-mix(in srgb, var(--nb-focus) 18%, transparent) !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:active": {
            "background": "var(--vscode-scrollbarSlider-activeBackground) !important",
            "box-shadow": "0 0 0 2px color-mix(in srgb, var(--nb-focus) 30%, transparent) !important"
        },
        ".monaco-count-badge": {
            "border-radius": "9999px !important",
            "font-size": "12px !important",
            "font-weight": "600 !important",
            "padding": "1px 7px !important",
            "min-height": "16px !important",
            "line-height": "16px !important",
            "border": "1px solid var(--nb-border-subtle) !important",
            "box-shadow": "0 1px 2px color-mix(in srgb, var(--vscode-widget-shadow, #000) 18%, transparent) !important"
        },
        ".sticky-widget": {
            "box-shadow": "0 4px 8px -2px color-mix(in srgb, #000 28%, transparent) !important"
        },
        ".monaco-sash:hover": {
            "background-color": "var(--vscode-sash-hoverBorder) !important",
            "box-shadow": "none !important"
        },
        ".monaco-editor .margin": {
            "border-right": "1px solid var(--nb-border-subtle) !important"
        },
        ".monaco-editor .cursor": {
            "filter": "none !important",
            "animation": "none !important"
        },
        ".monaco-workbench.vs-dark .monaco-icon-label.file-icon::before, .vs-dark .monaco-icon-label.file-icon::before": {
            "filter": "drop-shadow(0 0 2.5px currentColor)",
            "opacity": "1 !important"
        },
        ".letterpress": {
            "opacity": "0.4 !important"
        },
        ".chat-input-container": {
            "background-color": "var(--nb-surface) !important",
            "border-radius": "var(--nb-radius-widget) !important",
            "border": "1px solid var(--nb-border-soft) !important",
            "box-shadow": "var(--nb-surface-shadow) !important",
            "overflow": "visible !important"
        },
        ".interactive-input-part, .chat-editing-session-container, .chat-confirmation-widget2": {
            "border-radius": "var(--nb-radius-widget) !important",
            "overflow": "visible !important"
        },
        ".notebookOverlay": {
            "border-radius": "0 0 var(--nb-radius-panel) var(--nb-radius-panel) !important",
            "clip-path": "inset(0 18px var(--nb-panel-gap) var(--nb-panel-gap) round 0 0 var(--nb-radius-panel) var(--nb-radius-panel)) !important",
            "isolation": "isolate",
            "contain": "paint"
        },
        ".monaco-button-dropdown-separator": {
            "display": "none !important",
            "width": "0 !important",
            "opacity": "0 !important"
        },
        "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
                "background-color": "var(--vscode-editorWidget-background) !important"
            }
        },
        "@keyframes nb-settle-in": {
            "from": {
                "opacity": "0",
                "transform": "translateY(5px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateY(0)"
            }
        },
        "@keyframes nb-toast-in": {
            "from": {
                "opacity": "0",
                "transform": "translateX(8px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateX(0)"
            }
        },
        "@keyframes nb-tab-arrive": {
            "from": {
                "opacity": "0.7",
                "transform": "translateY(2px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateY(0)"
            }
        },
        "@keyframes nb-progress-sweep": {
            "0%": {
                "opacity": "0",
                "transform": "translateX(-100%)"
            },
            "40%": {
                "opacity": "1"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateX(100%)"
            }
        },
        "@media (prefers-reduced-transparency: reduce)": {
            ".monaco-workbench": {
                "--nb-surface": "var(--vscode-sideBar-background)",
                "--nb-surface-raised": "var(--vscode-editorWidget-background)",
                "--nb-pill": "var(--vscode-sideBar-background)"
            },
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important"
            }
        },
        "@media (prefers-reduced-motion: no-preference)": {
            ".tab:hover, .monaco-button:hover, .monaco-list-row:hover, .settings-editor .setting-item:hover, .part.activitybar .action-item:hover .action-label": {
                "transition": "var(--nb-transition-ui), transform var(--nb-motion-fast) var(--nb-ease-out) !important"
            },
            ".tab.active": {
                "animation": "nb-tab-arrive var(--nb-motion-base) var(--nb-ease-out) both !important"
            }
        },
        "@media (prefers-reduced-motion: reduce)": {
            ".monaco-workbench, .monaco-workbench *": {
                "transition-duration": "0ms !important",
                "animation": "none !important",
                "scroll-behavior": "auto !important"
            },
            ".monaco-breadcrumbs": {
                "opacity": "1 !important"
            },
            ".part.statusbar .statusbar-item-label, .part.statusbar .codicon": {
                "opacity": "1 !important"
            },
            ".tab .tab-actions, .tab .tab-close-action": {
                "opacity": "1 !important"
            },
            ".minimap canvas": {
                "opacity": "1 !important"
            },
            ".monaco-button:active, .action-label:active": {
                "transform": "none !important"
            }
        },
        "@media (prefers-contrast: more)": {
            ".monaco-workbench": {
                "--nb-glass-n": "color-mix(in oklch, var(--vscode-foreground) 52%, transparent)",
                "--nb-glass-w": "color-mix(in oklch, var(--vscode-foreground) 40%, transparent)",
                "--nb-glass-s": "color-mix(in oklch, var(--vscode-foreground) 40%, transparent)",
                "--nb-glass-e": "color-mix(in oklch, var(--vscode-foreground) 40%, transparent)",
                "--nb-border": "color-mix(in oklch, var(--vscode-foreground) 52%, transparent)",
                "--nb-border-subtle": "color-mix(in oklch, var(--vscode-foreground) 40%, transparent)"
            },
            ".monaco-breadcrumbs": {
                "opacity": "1 !important"
            },
            ".monaco-workbench :focus-visible": {
                "outline-width": "3px !important",
                "outline-offset": "3px !important"
            }
        },
        "@media (forced-colors: active)": {
            ".monaco-workbench, .monaco-workbench *": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important",
                "box-shadow": "none !important",
                "background-image": "none !important",
                "border-radius": "0 !important",
                "filter": "none !important"
            },
            ".monaco-workbench :focus-visible, .monaco-inputbox.focused, .monaco-findInput.focused, .scm-input:focus-within, .scm-editor:focus-within": {
                "outline": "2px solid CanvasText !important",
                "box-shadow": "none !important"
            },
            ".part.sidebar, .part.auxiliarybar, .part.panel.bottom, .part.activitybar, .part.statusbar, .part.editor": {
                "border": "1px solid CanvasText !important"
            },
            ".monaco-breadcrumbs, .part.statusbar .statusbar-item-label, .minimap canvas": {
                "opacity": "1 !important"
            }
        }
    },
    // ======================================================================
    // 14. CSS authoring — native color tools, modern syntax, and quiet linting
    // ----------------------------------------------------------------------
    // Uses VS Code's built-in CSS language service. No formatter extension is
    // prescribed so users can retain Prettier, Stylelint, or a team formatter.
    // Modern CSS guidance: prefer @layer for cascade control, @container for
    // component responsiveness, and :where() when reducing selector specificity.
    // ======================================================================
    "editor.colorDecorators": true,
    "editor.colorDecoratorsLimit": 500,
    "css.validate": true,
    "css.hover.documentation": true,
    "css.hover.references": true,
    "css.completion.completePropertyWithSemicolon": true,
    "css.completion.triggerPropertyValueCompletion": true,
    "css.lint.emptyRules": "warning",
    "css.lint.duplicateProperties": "warning",
    "css.lint.zeroUnits": "warning",
    "css.lint.unknownAtRules": "ignore",
    "css.lint.compatibleVendorPrefixes": "ignore",
    "emmet.showExpandedAbbreviation": "always",
    "emmet.includeLanguages": {
        "postcss": "css"
    },
    // ======================================================================
    // 15. Language-specific settings
    // ======================================================================
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.colorDecorators": true,
        "editor.foldingStrategy": "auto",
        "editor.suggest.showWords": false
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    // ======================================================================
    // 16. Modern VS Code features — AI assistance, diff, testing, notebooks
    // ----------------------------------------------------------------------
    // Inlay hints and ghost text for AI assistance
    // Diff editor enhanced presentation
    // Notebook interactive cell ergonomics
    // Breadcrumbs and quick-open navigation
    // ======================================================================
    "editor.ghostText.enabled": true,
    "workbench.editor.inlineSuggest.support.enabled": true,
    "diffEditor.overviewRulerBorder": true,
    "notebook.cell.border_width": 1,
    "notebook.cell.border_radius": 4,
    "terminal.integrated.darwin.borderStyle": "nil",
    "scm.startUpdateNotifications": false,
    "workbench.preferredDarkColorTheme": "Firefox NOVA Light"
}
