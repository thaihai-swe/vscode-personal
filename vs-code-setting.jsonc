            "width": "6px !important",
            "margin-left": "4px !important",
            "border-radius": "999px !important",
            "background": "color-mix(in oklch, var(--vscode-scrollbarSlider-background) 72%, var(--nb-focus)) !important",
            "transition": "width var(--nb-motion-fast) var(--nb-ease-out), background-color var(--nb-motion-fast) var(--nb-ease-out) !important"
        },
        ".monaco-scrollable-element > .scrollbar > .slider:hover": {
            "background": "var(--vscode-scrollbarSlider-hoverBackground) !important"
        },
        ".monaco-sash:hover": {
            "background-color": "var(--vscode-sash-hoverBorder) !important",
            "box-shadow": "none !important"
        },
        ".monaco-list-row.selected": {
            "background-color": "var(--vscode-list-activeSelectionBackground) !important",
            "color": "var(--vscode-list-activeSelectionForeground) !important"
        },
        ".monaco-tl-row:hover, .monaco-list-row:hover": {
            "background-color": "var(--nb-surface-highlight) !important"
        },
        ".monaco-breadcrumbs .breadcrumbs-item:hover": {
            "color": "var(--vscode-foreground) !important",
            "text-decoration": "underline dotted !important",
            "text-underline-offset": "3px !important"
        },
        ".monaco-hover .hover-row": {
            "padding": "2px 4px !important"
        },
        ".suggest-widget .details > .monaco-scrollable-element": {
            "border-radius": "var(--nb-radius-item) !important"
        },
        ".monaco-scrollable-element > .scrollbar.horizontal > .slider": {
            "height": "6px !important",
            "margin-top": "4px !important",
            "border-radius": "999px !important",
            "background": "color-mix(in oklch, var(--vscode-scrollbarSlider-background) 72%, var(--nb-focus)) !important"
        },
        ".monaco-editor .margin": {
            "border-right": "1px solid var(--nb-border-subtle) !important"
        },
        ".part.sidebar, .part.auxiliarybar, .part.panel.bottom, .part.activitybar": {
            "box-shadow": "inset 0 1px 0 var(--nb-glass-tint), var(--nb-surface-shadow) !important"
        },
        ".part.statusbar": {
            "box-shadow": "inset 0 1px 0 var(--nb-glass-tint), var(--nb-shadow-soft) !important"
        },
        "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
                "background-color": "var(--vscode-editorWidget-background) !important"
            }
        },
        ".command-center-center": {
            "border-radius": "999px !important",
            "border": "1px solid var(--nb-border) !important",
            "background-color": "var(--nb-surface) !important",
            "box-shadow": "none !important"
        },
        ".monaco-editor .cursor": {
            "filter": "none !important",
            "animation": "none !important"
        },
        "@keyframes nb-settle-in": {
            "from": {
                "opacity": "0",
                "transform": "translateY(5px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateY(0)"
            }
        },
        "@keyframes nb-toast-in": {
            "from": {
                "opacity": "0",
                "transform": "translateX(8px)"
            },
            "to": {
                "opacity": "1",
                "transform": "translateX(0)"
            }
        },
        "@keyframes nb-progress-sweep": {
            "0%": {
                "opacity": "0",
                "transform": "translateX(-100%)"
            },
            "40%": {
                "opacity": "1"
            },
            "100%": {
                "opacity": "1",
                "transform": "translateX(100%)"
            }
        },
        "@media (prefers-reduced-transparency: reduce)": {
            ".monaco-workbench": {
                "--nb-surface": "var(--vscode-sideBar-background)",
                "--nb-surface-raised": "var(--vscode-editorWidget-background)"
            },
            ".quick-input-widget, .suggest-widget, .monaco-hover, .monaco-dialog-box, .notification-toast, .notifications-center, .monaco-menu": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important"
            }
        },
        "@media (prefers-reduced-motion: reduce)": {
            ".monaco-workbench, .monaco-workbench *": {
                "transition-duration": "0ms !important",
                "animation": "none !important",
                "scroll-behavior": "auto !important"
            },
            ".tab::after, .monaco-progress-container .progress-bit": {
                "animation": "none !important",
                "transition": "none !important"
            },
            ".monaco-button:active, .action-label:active": {
                "transform": "none !important"
            }
        },
        "@media (prefers-contrast: more)": {
            ".monaco-workbench": {
                "--nb-border": "color-mix(in oklch, var(--vscode-foreground) 52%, transparent)",
                "--nb-border-subtle": "color-mix(in oklch, var(--vscode-foreground) 40%, transparent)"
            },
            ".part.sidebar, .part.auxiliarybar, .part.panel.bottom, .part.statusbar, .part.titlebar": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important"
            },
            ".monaco-workbench :focus-visible": {
                "outline-width": "3px !important",
                "outline-offset": "3px !important"
            },
            ".monaco-progress-container .progress-bit": {
                "animation-duration": "400ms !important"
            }
        },
        "@media (forced-colors: active)": {
            ".monaco-workbench, .monaco-workbench *": {
                "backdrop-filter": "none !important",
                "-webkit-backdrop-filter": "none !important",
                "box-shadow": "none !important",
                "background-image": "none !important",
                "border-radius": "0 !important"
            },
            ".monaco-workbench :focus-visible, .monaco-inputbox.focused, .monaco-findInput.focused, .scm-input:focus-within, .scm-editor:focus-within": {
                "outline": "2px solid CanvasText !important",
                "box-shadow": "none !important"
            },
            ".part.sidebar, .part.auxiliarybar, .part.panel.bottom, .part.activitybar, .part.statusbar, .part.editor": {
                "border": "1px solid CanvasText !important"
            },
            ".tab::after": {
                "background-color": "CanvasText !important"
            }
        }
    },
    // ======================================================================
    // 14. CSS authoring — native color tools, modern syntax, and quiet linting
    // ----------------------------------------------------------------------
    // Uses VS Code's built-in CSS language service. No formatter extension is
    // prescribed so users can retain Prettier, Stylelint, or a team formatter.
    // Modern CSS guidance: prefer @layer for cascade control, @container for
    // component responsiveness, and :where() when reducing selector specificity.
    // ======================================================================
    "editor.colorDecorators": true,
    "editor.colorDecoratorsLimit": 500,
    "css.validate": true,
    "css.hover.documentation": true,
    "css.hover.references": true,
    "css.completion.completePropertyWithSemicolon": true,
    "css.completion.triggerPropertyValueCompletion": true,
    "css.lint.emptyRules": "warning",
    "css.lint.duplicateProperties": "warning",
    "css.lint.zeroUnits": "warning",
    "css.lint.unknownAtRules": "ignore",
    "css.lint.compatibleVendorPrefixes": "ignore",
    "emmet.showExpandedAbbreviation": "always",
    "emmet.includeLanguages": {
        "postcss": "css"
    },
    // ======================================================================
    // 15. Language-specific settings
    // ======================================================================
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.colorDecorators": true,
        "editor.foldingStrategy": "auto",
        "editor.suggest.showWords": false
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "workbench.editor.tabActionLocation": "right",
    // ======================================================================
    // 16. Modern VS Code features — AI assistance, diff, testing, notebooks
    // ----------------------------------------------------------------------
    // Inlay hints and ghost text for AI assistance
    // Diff editor enhanced presentation
    // Notebook interactive cell ergonomics
    // Breadcrumbs and quick-open navigation
    // ======================================================================
    "editor.ghostText.enabled": true,
    "workbench.editor.inlineSuggest.support.enabled": true,
    "diffEditor.overviewRulerBorder": true,
    "notebook.cell.border_width": 1,
    "notebook.cell.border_radius": 4,
    "terminal.integrated.darwin.borderStyle": "nil",
    "scm.startUpdateNotifications": false,
    // ======================================================================
    // Theme-specific color customizations — high-alpha glass chrome
    // ----------------------------------------------------------------------
    // Lower opacity so backdrop-filter can frost through. Tabs header stays
    // fully transparent so the editor card glass reads continuously.
    // Indent guides and bracket colors are defined directly within each theme.
    // ======================================================================
    "workbench.colorTheme": "Minimal"
}
