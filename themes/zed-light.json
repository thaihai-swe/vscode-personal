    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#a2a3a7",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc Comments",
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#7c7e86",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.trycatch",
                "keyword.operator.new",
                "keyword.operator.expression"
            ],
            "settings": {
                "foreground": "#a449ab"
            }
        },
        {
            "name": "Storage",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier",
                "storage.type.function",
                "storage.type.class",
                "storage.type.interface",
                "storage.type.enum",
                "storage.type.type"
            ],
            "settings": {
                "foreground": "#a449ab"
            }
        },
        {
            "name": "Functions and Methods",
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#5b79e3"
            }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#d3604f"
            }
        },
        {
            "name": "Types, Classes and Interfaces",
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.interface",
                "entity.name.type.enum",
                "entity.name.type.struct",
                "entity.name.type.type",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#3882b7"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.quoted.single",
                "string.quoted.double",
                "string.quoted.triple"
            ],
            "settings": {
                "foreground": "#649f57"
            }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#a449ab"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "Booleans and Built-in Constants",
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "variable.other.constant",
                "variable.other.enummember",
                "constant.other"
            ],
            "settings": {
                "foreground": "#c18401"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.object"
            ],
            "settings": {
                "foreground": "#242529"
            }
        },
        {
            "name": "Special Language Variables (this, self, super)",
            "scope": [
                "variable.language",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "Properties and Object Keys",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.type.property-name",
                "meta.object-literal.key",
                "entity.name.tag.yaml",
                "meta.property-name"
            ],
            "settings": {
                "foreground": "#d3604f"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#3882b7"
            }
        },
        {
            "name": "Punctuation and Delimiters",
            "scope": [
                "punctuation",
                "punctuation.separator",
                "punctuation.terminator",
                "meta.brace",
                "meta.bracket"
            ],
            "settings": {
                "foreground": "#4d4f52"
            }
        },
        {
            "name": "HTML/JSX/XML Tags",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#5c78e2"
            }
        },
        {
            "name": "Tag Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.jsx",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "Regexp and Escape Sequences",
            "scope": [
                "string.regexp",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#ad6e26"
            }
        },
        {
            "name": "Decorators and Annotations",
            "scope": [
                "meta.decorator",
                "meta.annotation",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "CSS/SCSS Selectors and Classes",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.other.attribute-name.pseudo-class.css"
            ],
            "settings": {
                "foreground": "#669f59"
            }
        },
        {
            "name": "CSS Property Names",
            "scope": [
                "support.type.property-name.css",
                "support.type.property-name.media"
            ],
            "settings": {
                "foreground": "#5b79e3"
            }
        },
        {
            "name": "CSS Property Values",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": {
                "foreground": "#ad6e25"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#5c78e2",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "settings": {
                "foreground": "#ad6e25",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "settings": {
                "foreground": "#a449ab",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Code",
            "scope": [
                "markup.inline.raw",
                "markup.raw.block"
            ],
            "settings": {
                "foreground": "#649f57"
            }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "string.other.link",
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#5b79e3",
                "fontStyle": "italic"
            }
        }
    ]
}