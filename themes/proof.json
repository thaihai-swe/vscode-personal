        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.media",
        "support.type.vendored.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "meta.property-name.css",
        "meta.property-name.scss",
        "meta.property-name.less"
      ],
      "settings": {
        "foreground": "#8c564b"
      }
    },
    {
      "name": "CSS Custom Properties / Variables",
      "scope": [
        "support.type.custom-property.name.css",
        "support.type.custom-property.name.scss",
        "support.type.custom-property.name.less",
