    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8b80a4",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#fb923c"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#fb923c"
            }
        },
        {
            "scope": [
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#fb923c",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#60a5fa"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#38bdf8"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#c084fc",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#f87171"
            }
        },
        {
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#7c7094",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#b99cff"
            }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#b99cff"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#6ee7b7"
            }
        },
        {
            "scope": [
                "string.regexp",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#f472b6"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.language"
            ],
            "settings": {
                "foreground": "#ece7f4"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#c084fc"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#c4b5fd"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#b99cff"
            }
        },
        {
            "scope": [
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#a99bbd"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.bracket"
            ],
            "settings": {
                "foreground": "#b9aecb"
            }
        },
        {
            "scope": [
                "markup.heading"
