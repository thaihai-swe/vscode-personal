    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#887e9c",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#b45309"
            }
        },
        {
            "scope": [
                "constant.numeric",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#c2410c"
            }
        },
        {
            "scope": [
                "constant.language.boolean"
            ],
            "settings": {
                "foreground": "#b45309",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#1d4ed8"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.scope-resolution",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#0284c7"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#7c3aed",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#dc2626"
            }
        },
        {
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#9f96b2",
                "fontStyle": "strikethrough"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.logical",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#6d28d9"
            }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#6d28d9"
            }
        },
        {
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#047857"
            }
        },
        {
            "scope": [
                "string.regexp",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#be185d"
            }
        },
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.language"
            ],
            "settings": {
                "foreground": "#241e33"
            }
        },
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#7c3aed"
            }
        },
        {
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#3730a3"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#6d28d9"
            }
        },
        {
            "scope": [
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#8c82a2"
            }
        },
        {
            "scope": [
                "punctuation",
                "meta.brace",
                "meta.bracket"
            ],
            "settings": {
                "foreground": "#5b5173"
            }
        },
        {
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#5b21b6",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "markup.inserted.diff"
            ],
            "settings": {
                "foreground": "#059669"
            }
        },
        {
            "scope": [
                "markup.deleted.diff"
            ],
            "settings": {
                "foreground": "#dc2626"
            }
        },
        {
            "scope": [
                "meta.diff.range"
            ],
            "settings": {
                "foreground": "#7c3aed"
            }
        },
        {
            "scope": [
                "meta.import",
                "meta.export"
            ],
            "settings": {
                "foreground": "#6d28d9"
            }
        },
        {
            "scope": [
                "comment.todo"
