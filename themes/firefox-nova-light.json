                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "comment.note"
            ],
            "settings": {
                "foreground": "#0284c7",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "entity.name.tag.css",
